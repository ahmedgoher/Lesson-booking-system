@model Al_Muzayyen.Viewmodel.StudentLoginVM

@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "تسجيل دخول الطالب";
}

<style>
    /* Auth Section Layout */
    .auth-section {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background-color: var(--bg-main);
    }

    .auth-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 440px;
        box-shadow: var(--shadow-md);
        transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .auth-header h2 {
            color: var(--text-color);
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 0.4rem;
        }

        .auth-header p {
            color: var(--text-muted);
            font-size: 0.88rem;
        }

    /* Form & Controls */
    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

        .form-group label {
            color: var(--text-color);
            font-size: 0.88rem;
            font-weight: 600;
        }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .forgot-pass-link {
        color: var(--primary-color);
        font-size: 0.8rem;
        text-decoration: none;
    }

    /* Input Wrapper & Icons */
    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        right: 14px;
        color: var(--text-muted);
        font-size: 1rem;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 2.6rem 0.75rem 2.6rem;
        background-color: var(--bg-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-color);
        font-size: 0.92rem;
        outline: none;
        transition: all 0.25s ease;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px var(--primary-glow);
        }

    .toggle-password {
        position: absolute;
        left: 12px;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
    }

    .form-group-checkbox {
        display: flex;
        align-items: center;
    }

    .remember-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.85rem;
        cursor: pointer;
    }

    .auth-submit-btn {
        width: 100%;
        padding: 0.8rem;
        background-color: var(--primary-color);
        color: #000000;
        font-weight: 700;
        font-size: 0.95rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .auth-footer {
        margin-top: 1.8rem;
        text-align: center;
        border-top: 1px solid var(--border-color);
        padding-top: 1.2rem;
    }

    .register-link {
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
    }

    .text-danger {
        color: #ef4444;
        font-size: 0.8rem;
        margin-top: 0.2rem;
    }
</style>

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <h2>تسجيل الدخول للطالب</h2>
            <p>أهلاً بك مجدداً! أدخل بياناتك للمتابعة</p>
        </div>

        <!-- رسالة الخطأ العامة إن وجدت -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 10px; border-radius: 8px; text-align: center; margin-bottom: 15px; border: 1px solid #ef4444;">
                @ViewBag.Error
            </div>
        }

        <!-- Form -->
        <form asp-controller="Account" asp-action="login2" method="post" class="auth-form" id="loginForm">

            <!-- Phone Number Input -->
            <div class="form-group">
                <label asp-for="PhoneNumber">رقم الهاتف</label>
                <div class="input-wrapper">
                    <i class="fas fa-phone-alt input-icon"></i>
                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="010XXXXXXXX" />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <!-- Password Input -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="Password">كلمة السر</label>
                    <a href="#" class="forgot-pass-link">نسيت كلمة السر؟</a>
                </div>
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="Password"
                           class="form-control"
                           placeholder="••••••••" />
                    <button type="button" class="toggle-password" id="togglePasswordBtn">
                        <i class="fas fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Remember Me Checkbox -->
            <div class="form-group-checkbox">
                <label class="remember-label">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>تذكرني على هذا الجهاز</span>
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary auth-submit-btn">
                <span>تسجيل الدخول</span>
                <i class="fas fa-arrow-left"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>ليس لديك حساب حتى الآن؟ <a href="/Booking/booking" class="register-link">إنشاء حساب جديد</a></p>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('Password');
        const toggleIcon = document.getElementById('toggleIcon');

        if (togglePasswordBtn && passwordInput && toggleIcon) {
            togglePasswordBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.classList.toggle('fa-eye', !isPassword);
                toggleIcon.classList.toggle('fa-eye-slash', isPassword);
            });
        }
    });
</script>