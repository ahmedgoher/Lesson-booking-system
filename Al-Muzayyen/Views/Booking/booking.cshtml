@model Al_Muzayyen.Models.Student
@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "إنشاء حساب طالب جديد";
    var classes = ViewBag.Classes as IEnumerable<Al_Muzayyen.Models.Class>;
    var places = ViewBag.Places as IEnumerable<Al_Muzayyen.Models.Place>;
}

<!-- 🎨 تنسيقات خاصة بهذه الصفحة فقط لعدم التعديل على style.css الرئيسي -->
<style>
    .booking-form input[type="password"] {
        width: 100%;
        background-color: var(--bg-alt, #0e1524);
        border: 1px solid var(--border-color, #263349);
        color: var(--text-color, #f8fafc);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 1rem;
        font-family: 'Cairo', sans-serif;
        outline: none;
        box-sizing: border-box;
    }

        .booking-form input[type="password"]:focus {
            border-color: var(--primary-color, #d4af37);
            box-shadow: 0 0 0 3px var(--primary-glow, rgba(212, 175, 55, 0.45));
        }

    /* إصلاح لون خلفية الإكمال التلقائي من المتصفح (Autofill) */
    .booking-form input:-webkit-autofill,
    .booking-form input:-webkit-autofill:hover,
    .booking-form input:-webkit-autofill:focus {
        -webkit-text-fill-color: var(--text-color, #f8fafc) !important;
        -webkit-box-shadow: 0 0 0px 1000px var(--bg-alt, #0e1524) inset !important;
        transition: background-color 5000s ease-in-out 0s;
    }
</style>

<div class="booking-page-wrap">
    <div class="container">
        <div class="booking-form">
            <a href="/Home" class="back-btn">
                <i class="fas fa-arrow-right"></i>
                العودة للرئيسية
            </a>
            <h2 style="text-align: center; margin-bottom: 30px;">إنشاء حساب طالب جديد</h2>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success" style="text-align: center; padding: 10px; margin-bottom: 20px;">
                    @ViewBag.SuccessMessage
                </div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" style="text-align: center; padding: 10px; margin-bottom: 20px;">
                    @ViewBag.ErrorMessage
                </div>
            }

            <!-- 🟢 تم التعديل هنا: استخدام asp-controller و asp-action وإضافة @Html.AntiForgeryToken() -->
            <form asp-controller="Booking" asp-action="booking" method="post" id="student-booking-form">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>اسم الطالب بالكامل</label>
                    @* <input type="text" name="Name" id="student-name" placeholder="أدخل اسمك الثلاثي" value="@Model?.Name"> *@
                    <input asp-for="Name" id="student-name" placeholder="أدخل اسمك الثلاثي">
                    <span asp-validation-for="Name" class="text-danger" style="color: red; font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>

                <div class="form-group">
                    <label>رقم الهاتف (سيستخدم لتسجيل الدخول)</label>
                    @* <input type="tel" name="StdPhone" id="student-phone" placeholder="01xxxxxxxxx" value="@Model?.StdPhone"> *@
                    <input asp-for="StdPhone" id="student-phone" placeholder="01xxxxxxxxx">
                    <span asp-validation-for="StdPhone" class="text-danger" style="color: red; font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>

                <div class="form-group">
                    <label>رقم ولي الأمر</label>
                    @* <input type="tel" name="ParentPhone" id="student-guardian-phone" placeholder="01xxxxxxxxx" value="@Model?.ParentPhone"> *@
                    <input asp-for="ParentPhone" id="student-guardian-phone" placeholder="01xxxxxxxxx">
                    <span asp-validation-for="ParentPhone" class="text-danger" style="color: red; font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>

                <!-- 🔑 حقل كلمة المرور -->
            
                <div class="form-group">
                    <label>الصف الدراسي</label>
                    <select asp-for="ClassId" id="select-grade">
                        <option value="0">اختر الصف</option>
                        @if (classes != null)
                        {
                            foreach (var c in classes)
                            {
                                <option value="@c.Id" selected="@(Model?.ClassId == c.Id ? "selected" : null)">@c.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ClassId" class="text-danger" style="font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>

                <div class="form-group">
                    <label>مكان الدرس</label>
                    <select asp-for="PlaceId" id="select-location">
                        <option value="0">اختر المكان</option>
                        @if (places != null)
                        {
                            foreach (var p in places)
                            {
                                <option value="@p.Id" selected="@(Model?.PlaceId == p.Id ? "selected" : null)">@p.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="PlaceId" class="text-danger" style="font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>

                <div class="form-group">
                    <label>المجموعة المتاحة</label>
                    <select asp-for="SlotId" id="select-group" disabled>
                        <option value="0">اختر المجموعة</option>
                    </select>
                    <span asp-validation-for="SlotId" class="text-danger" style="font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>
                <div class="form-group">
                    <label>كلمة المرور</label>
                    @* <input type="password" name="Password" id="student-password" placeholder="أدخل كلمة المرور (ستستخدم لتسجيل الدخول)"> *@
                    <input asp-for="Password" id="student-password" placeholder="أدخل كلمة المرور (ستستخدم لتسجيل الدخول)">
                    <span asp-validation-for="Password" class="text-danger" style="color: red; font-size: 13px; display: block; margin-top: 5px;"></span>
                </div>

                <div class="form-group">
                    <label>ملاحظات (اختياري)</label>
                    <textarea asp-for="Notes" id="student-note" placeholder="اكتب أي ملاحظة أو استفسار..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">إنشاء الحساب وتأكيد الحجز</button>
            </form>

            <div class="whatsapp-contact">
                <a id="whatsappBtn" target="_blank" class="whatsapp-btn">
                    <i class="fab fa-whatsapp"></i>
                    تواصل معنا عبر واتساب
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const gradeSelect = document.getElementById('select-grade');
        const locationSelect = document.getElementById('select-location');
        const groupSelect = document.getElementById('select-group');

        async function updateGroups() {
            const gradeId = gradeSelect.value;
            const locationId = locationSelect.value;

            if (!gradeId || gradeId === "0" || !locationId || locationId === "0") {
                groupSelect.innerHTML = '<option value="0">اختر المجموعة</option>';
                groupSelect.disabled = true;
                return;
            }

            groupSelect.innerHTML = '<option value="0">جاري تحميل المجموعات...</option>';
            groupSelect.disabled = true;

            try {
                const response = await fetch(`/Booking/GetAvailableSlots?classId=${gradeId}&placeId=${locationId}`);

                if (response.ok) {
                    const slots = await response.json();
                    groupSelect.innerHTML = '<option value="0">اختر المجموعة</option>';

                    if (slots.length > 0) {
                        slots.forEach(slot => {
                            const opt = document.createElement('option');
                            opt.value = slot.id;
                            opt.textContent = slot.name;
                            if ("@Model?.SlotId" == slot.id) opt.selected = true;
                            groupSelect.appendChild(opt);
                        });
                        groupSelect.disabled = false;
                    } else {
                        groupSelect.innerHTML = '<option value="0">لا توجد مجموعات متاحة حالياً لهذا الصف في هذا المكان</option>';
                    }

                    if ($("form").data("validator")) {
                        $("form").validate().element("#select-group");
                    }
                }
            } catch (error) {
                console.error("حدث خطأ أثناء جلب المجموعات:", error);
                groupSelect.innerHTML = '<option value="0">حدث خطأ أثناء تحميل البيانات</option>';
            }
        }

        gradeSelect.addEventListener('change', updateGroups);
        locationSelect.addEventListener('change', updateGroups);

        if (gradeSelect.value && gradeSelect.value !== "0" && locationSelect.value && locationSelect.value !== "0") {
            updateGroups();
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var phone = "@ViewBag.number";
        document.getElementById("whatsappBtn").href =
            "https://wa.me/20" + phone +
            "?text=" + encodeURIComponent("السلام عليكم، أريد الاستفسار عن الحجز وتسجيل الحساب");
    });
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}