@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "تغيير كلمة سر الطالب";
}

<link rel="stylesheet" href="~/css/styleadmin.css">

<style>
    .change-password-container {
        padding: 30px 15px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .custom-pwd-card {
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        width: 100%;
        max-width: 520px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-pwd-card:hover {
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        }

    .custom-card-header {
        background: linear-gradient(135deg, var(--primary-color, #c5a059) 0%, #a3813c 100%);
        color: #ffffff;
        padding: 22px 20px;
        text-align: center;
    }

        .custom-card-header h4 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

    .custom-card-body {
        padding: 30px;
    }

    .form-group-custom {
        margin-bottom: 22px;
        text-align: right;
    }

        .form-group-custom label {
            font-weight: 600;
            font-size: 14px;
            color: var(--text-color, #1e293b);
            margin-bottom: 8px;
            display: block;
        }

    .input-group-custom {
        display: flex;
        align-items: center;
        border: 1px solid var(--border-color, #cbd5e1);
        border-radius: 10px;
        overflow: hidden;
        background-color: #fff;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }

        .input-group-custom:focus-within {
            border-color: var(--primary-color, #c5a059);
            box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.18);
        }

        .input-group-custom input {
            border: none;
            outline: none;
            padding: 12px 15px;
            font-size: 14px;
            width: 100%;
            color: #334155;
            background: transparent;
        }

        .input-group-custom .input-icon {
            padding: 0 15px;
            color: #94a3b8;
            font-size: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .toggle-password {
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .toggle-password:hover {
            color: var(--primary-color, #c5a059);
        }

    .btn-submit-pwd {
        background: linear-gradient(135deg, var(--primary-color, #c5a059) 0%, #b08d48 100%);
        color: #ffffff;
        border: none;
        width: 100%;
        padding: 13px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(197, 160, 89, 0.25);
    }

        .btn-submit-pwd:hover {
            opacity: 0.95;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(197, 160, 89, 0.35);
        }

        .btn-submit-pwd:active {
            transform: translateY(0);
        }

    .alert-custom {
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 14px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }

    .alert-success-custom {
        background-color: #dcfce7;
        color: #15803d;
    }

    .alert-danger-custom {
        background-color: #fee2e2;
        color: #b91c1c;
    }

    .help-text {
        font-size: 12px;
        color: #64748b;
        margin-top: 6px;
        display: block;
    }

    .error-feedback {
        color: #ef4444;
        font-size: 13px;
        margin-top: 6px;
        display: none;
        font-weight: 600;
    }
</style>

<div class="change-password-container rtl" dir="rtl">
    <div class="custom-pwd-card">
        <!-- هيدر الكارت -->
        <div class="custom-card-header">
            <h4><i class="fas fa-key"></i> تغيير كلمة سر الطالب</h4>
        </div>

        <div class="custom-card-body">
            <!-- عرض رسائل النجاح أو الخطأ -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-custom alert-success-custom">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-custom alert-danger-custom">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <!-- نموذج تغيير كلمة السر -->
            <form asp-controller="Admin" asp-action="ChangeStudentPassword" method="post" id="changePasswordForm">
                @Html.AntiForgeryToken()

                <!-- رقم الهاتف -->
                <div class="form-group-custom">
                    <label for="phoneNumber">رقم هاتف الطالب <span class="text-danger">*</span></label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="fas fa-phone"></i></span>
                        <input type="tel" id="phoneNumber" name="phoneNumber"
                               placeholder="أدخل رقم الهاتف المسجل (مثال: 01012345678)"
                               required pattern="[0-9]{10,15}" dir="ltr" class="text-end">
                    </div>
                    <span class="help-text">اكتب رقم الهاتف المرتبط بحساب الطالب لتعيين كلمة السر الجديدة.</span>
                </div>

                <!-- كلمة السر الجديدة -->
                <div class="form-group-custom">
                    <label for="newPassword">كلمة السر الجديدة <span class="text-danger">*</span></label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" id="newPassword" name="newPassword"
                               placeholder="أدخل كلمة السر الجديدة" required minlength="6" dir="ltr" class="text-end">
                        <span class="input-icon toggle-password" onclick="togglePasswordVisibility('newPassword', this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <!-- تأكيد كلمة السر -->
                <div class="form-group-custom">
                    <label for="confirmPassword">تأكيد كلمة السر <span class="text-danger">*</span></label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="fas fa-check-circle"></i></span>
                        <input type="password" id="confirmPassword"
                               placeholder="أعِد كتابة كلمة السر" required dir="ltr" class="text-end">
                        <span class="input-icon toggle-password" onclick="togglePasswordVisibility('confirmPassword', this)">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                    <div id="passwordError" class="error-feedback">
                        <i class="fas fa-exclamation-circle"></i> كلمات السر غير متطابقة!
                    </div>
                </div>

                <!-- زر الحفظ -->
                <button type="submit" class="btn-submit-pwd" id="submitBtn">
                    <i class="fas fa-save"></i> تحديث كلمة السر
                </button>
            </form>
        </div>
    </div>
</div>


    <script>
        // 1. التحقق من تطابق كلمتي السر قبل الإرسال
        document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
            var password = document.getElementById('newPassword').value;
            var confirmPassword = document.getElementById('confirmPassword').value;
            var errorDiv = document.getElementById('passwordError');

            if (password !== confirmPassword) {
                e.preventDefault();
                errorDiv.style.display = 'block';
            } else {
                errorDiv.style.display = 'none';
            }
        });

        // 2. دالة إظهار / إخفاء كلمة السر
        function togglePasswordVisibility(inputId, iconElement) {
            const input = document.getElementById(inputId);
            const icon = iconElement.querySelector('i');

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = "password";
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
