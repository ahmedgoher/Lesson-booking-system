@model IEnumerable<Al_Muzayyen.Models.Place>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Locations";
}
@if (TempData["Error"] != null)
{
    <div style="color: red; background: #f8d7da; padding: 10px; border-radius: 6px; text-align: center; margin-bottom: 15px;">
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div style="color: green; background: #d4edda; padding: 10px; border-radius: 6px; text-align: center; margin-bottom: 15px;">
        @TempData["Success"]
    </div>
}
<section id="locations-section">

    <div class="section-header-block">
        <h2>إدارة الأماكن</h2>

        <button class="action-button"
                onclick="openAddLocationModal()">
            إضافة مكان جديد
        </button>
    </div>

    <div class="table-responsive-container">


<table class="data-display-table">
    <thead>
        <tr>
            <th>اسم المكان</th>
            <th>العنوان</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody id="locations-table-body">
        @if (Model != null && Model.Any())
        {
            foreach (var place in Model)
            {
                <tr data-id="@place.Id">
                    <td>@place.Name</td>
                    <td>@place.Address</td>
                    <td>
                        <button onclick="editLocation(this)" class="action-icon-btn" style="color:blue;">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteLocation(this)" class="action-icon-btn" style="color:red;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" style="text-align:center; color:gray;">لا توجد أماكن مسجلة حالياً.</td>
            </tr>
        }
    </tbody>
</table>

    </div>

</section>

@section model {

    <div id="location-edit-modal" class="custom-popup-overlay">
        <div class="popup-window-content">
            <h3>تعديل المكان</h3>

            <form id="edit-location-form" asp-action="EditLocation" asp-controller="Admin" method="post">

                <input type="hidden" id="edit-location-id" name="Id">

                <div class="input-field-group">
                    <label>اسم المكان</label>
                    <input type="text" id="edit-location-name" name="Name" required>
                </div>

                <div class="input-field-group">
                    <label>العنوان</label>
                    <input type="text" id="edit-location-address" name="Address" required>
                </div>

                <div class="popup-actions-flex">
                    <button type="submit" class="action-button">حفظ</button>
                    <button type="button" class="action-button" style="background:#ccc;color:#333;" onclick="closeModal('location-edit-modal')">إلغاء</button>
                </div>
            </form>
        </div>
    </div>
    <form id="delete-location-form" asp-action="DeleteLocation" asp-controller="Admin" method="post" style="display:none;">
        <input type="hidden" id="delete-location-id" name="id">
    </form>
    <div id="location-add-modal" class="custom-popup-overlay">

        <div class="popup-window-content">

            <h3>إضافة مكان جديد</h3>

            <form id="add-location-form" asp-action="AddLocation" asp-controller="Admin" method="post">

                @if (TempData["Error"] != null)
                {
                    <div style="color:red; margin-bottom:10px; font-weight:bold;">@TempData["Error"]</div>
                }

                <div class="input-field-group">
                    <label>اسم المكان</label>
                    <input type="text" name="Name" required>
                </div>

                <div class="input-field-group">
                    <label>العنوان</label>
                    <input type="text" name="Address" required>
                </div>

                <div class="popup-actions-flex">
                    <button type="submit" class="action-button">
                        إضافة
                    </button>

                    <button type="button"
                            class="action-button"
                            style="background:#ccc;color:#333;"
                            onclick="closeModal('location-add-modal')">
                        إلغاء
                    </button>
                </div>

            </form>

        </div>

    </div>
    }

    <script>
  
            function openModal(id){

        document.getElementById(id).style.display="flex";

    }

    function closeModal(id){

        document.getElementById(id).style.display="none";


    }


        function openAddLocationModal(){

        document.getElementById("add-location-form").reset();

        openModal("location-add-modal");

    }

        function editLocation(button){

        const row = button.closest("tr");

        const cells = row.querySelectorAll("td");

        document.getElementById("edit-location-id").value =
            row.dataset.id;

        document.getElementById("edit-location-name").value =
            cells[0].textContent.trim();

        document.getElementById("edit-location-address").value =
            cells[1].textContent.trim();

        openModal("location-edit-modal");

    }

            function deleteLocation(button){
        // جلب الـ ID الحقيقي من السطر
        const row = button.closest("tr");
        const id = row.dataset.id;

        if(confirm("هل تريد حذف هذا المكان نهائياً من الداتابيز؟")){
            // وضع الـ ID في الفورم المخفية وعمل Submit تلقائي
            document.getElementById("delete-location-id").value = id;
            document.getElementById("delete-location-form").submit();
        }
    }
</script>