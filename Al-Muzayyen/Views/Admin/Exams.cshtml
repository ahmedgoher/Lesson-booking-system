    // إرسال بيانات السؤال للخادم
    // إرسال بيانات الامتحان للخادم
    async function saveExam() {

        const gradeId = document.getElementById("exam-grade").value;

        if (!gradeId) {
            alert("يرجى اختيار الصف الدراسي");
            return;
        }

        const payload = {

            id: Number(document.getElementById("exam-id").value) || 0,

            title: document.getElementById("exam-title").value.trim(),

            description: document.getElementById("exam-description").value.trim(),

            gradeId: Number(gradeId),

            date: document.getElementById("exam-date").value,

            duration: Number(document.getElementById("exam-duration").value) || 30,

            openDate: document.getElementById("exam-open").value || null,

            closeDate: document.getElementById("exam-close").value || null,

            totalMarks: Number(document.getElementById("exam-total-marks").value) || 100,

            passingMarks: Number(document.getElementById("exam-passing-marks").value) || 50,

            maxAttempts: Number(document.getElementById("exam-max-attempts").value) || 1,

            status: document.getElementById("exam-status").value,

            randomQuestions: document.getElementById("exam-random-questions").checked,

            shuffleAnswers: document.getElementById("exam-shuffle-answers").checked,

            allowReview: document.getElementById("exam-allow-review").checked,

            showResult: document.getElementById("exam-show-result").checked
        };

        if (payload.title.length === 0) {
            alert("يرجى إدخال عنوان الامتحان");
            return;
        }

        try {

            const response = await fetch("/Admin/SaveExam", {

                method: "POST",

                headers: {

                    "Content-Type": "application/json",

                    "RequestVerificationToken": getAntiforgeryToken()

                },

                body: JSON.stringify(payload)

            });

            const result = await response.json();

            if (result.success) {

                closeModal("exam-modal");

                alert(result.message);

                location.reload();

            }
            else {

                alert(result.message);

            }

        }
        catch (ex) {

            console.error(ex);

            alert("حدث خطأ أثناء الاتصال بالخادم.");

        }

    }

    async function saveQuestion() {
        const saveBtn = document.getElementById("save-question-btn");

saveBtn.disabled = true;
saveBtn.innerText = "جارى الحفظ...";

    const type = document.getElementById("question-type").value;

    const options = document.querySelectorAll(".mcq-option-input");

    let correctAnswer = "";

    if (type === "MCQ") {

        const selected =
            document.querySelector("input[name='correct-mcq']:checked");

        switch (selected.value) {

            case "0":
                correctAnswer = "A";
                break;

            case "1":
                correctAnswer = "B";
                break;

            case "2":
                correctAnswer = "C";
                break;

            case "3":
                correctAnswer = "D";
                break;
        }
    }
    else {

        correctAnswer =
            document.querySelector("input[name='tf-correct']:checked").value === "true"
                ? "True"
                : "False";
    }

    const formData = new FormData();

formData.append("ExamId", document.getElementById("question-exam-id").value);

formData.append("QuestionText", document.getElementById("question-text").value);

formData.append("Mark", document.getElementById("question-mark").value);

formData.append("Type", type);

formData.append("OptionA", options[0].value);

formData.append("OptionB", options[1].value);

formData.append("OptionC", options[2].value);

formData.append("OptionD", options[3].value);

formData.append("CorrectAnswer", correctAnswer);

const image =
    document.getElementById("question-image").files[0];

if (image) {

    formData.append("image", image);

}

    const questionText = document.getElementById("question-text").value.trim();

if (questionText === "") {

    alert("اكتب السؤال");

    return;
}

    try {

        const response = await fetch("/Admin/SaveQuestion", {

            method: "POST",

           headers:{
RequestVerificationToken:getAntiforgeryToken()
},

            body: formData

        });

        const result = await response.json();

        if (result.success) {

            alert(result.message);

            closeModal("question-modal");

            document.getElementById("question-form").reset();

            toggleQuestionOptions();

            location.reload();

        }
        else {

            alert(result.message);

        }

    }
    catch (e) {

        console.error(e);

        alert("حدث خطأ أثناء الاتصال بالسيرفر");

    }
    finally {

    saveBtn.disabled = false;
    saveBtn.innerText = "حفظ السؤال";

}

}
    // حذف امتحان
    async function deleteExam(examId) {
        if (!confirm('هل أنت تأكد من رغبتك في حذف هذا الامتحان بالكامل؟')) return;

        try {
            const response = await fetch(`/Admin/DeleteExam/${examId}`, {
                method: 'POST', // يفضل إرسالها كـ POST مع التوكن
                headers: {
                    'RequestVerificationToken': getAntiforgeryToken()
                }
            });

            if (response.ok) {
                location.reload();
            } else {
                alert('حدث خطأ أثناء محاولة الحذف.');
            }
        } catch (error) {
            console.error(error);
            alert('تعذر الاتصال بالخادم.');
        }
    }
</script>