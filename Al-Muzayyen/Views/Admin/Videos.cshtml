@model List<Video>
@{
    Layout = "~/Views/Shared/_layoutadmin.cshtml";
    ViewData["Title"] = "videos";
}


<!-- قسم إدارة الفيديوهات -->
<section id="videos-section"  " class="videos">
    <div class="container">

        <div class="section-title">
            <h2>فيديوهات الأستاذ</h2>
            <p>تعرف على الأستاذ عبد الفتاح المزين من خلال مجموعة من الفيديوهات المميزة.</p>
        </div>

        <div class="videos-grid">

            @foreach (var video in Model)
            {
                <div class="video-card" data-id="@video.Id">
                    <iframe src="@video.URL"
                            title="@video.Title"
                            allowfullscreen>
                    </iframe>

                    <h3>@video.Title</h3>
                    <p>@video.Description</p>

                    <button class="edit-video-btn" onclick="openVideoPopup(this)">
                        <i class="fas fa-edit"></i>
                        تعديل
                    </button>
                </div>


            }


        </div>

    </div>
</section>

@section model{
    <div id="videoModal" class="modal">
        <div class="modal-content">

            <h2>تعديل الفيديو</h2>

            <form asp-action="EditVideo" asp-controller="Admin" method="post">
                <input type="hidden" id="videoId" name="Id" />
                <label>رابط الفيديو</label>

                <input type="text" id="videoLink" name="URL" />

                <label>العنوان</label>
                <input type="text" id="videoTitle" name="Title" />

                <label>الوصف</label>
                <textarea id="videoDescription" name="Description"></textarea>

                <div class="modal-buttons">
                    <button type="submit">حفظ</button>
                    <button type="button" onclick="closeVideoPopup()">إلغاء</button>
                </div>

            </form>


        </div>

       
    </div>
    }
}