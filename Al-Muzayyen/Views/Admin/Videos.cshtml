@{
    Layout = "~/Views/Shared/_layoutadmin.cshtml";
    ViewData["Title"] = "videos";
}


<!-- قسم إدارة الفيديوهات -->
<section id="videos-section"  " class="videos">
    <div class="container">

        <div class="section-title">
            <h2>فيديوهات الأستاذ</h2>
            <p>تعرف على الأستاذ عبد الفتاح المزين من خلال مجموعة من الفيديوهات المميزة.</p>
        </div>

        <div class="videos-grid">

            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/i59pw-1VHFc?si=XSdqs0Kssxsap8fE"
                        title="رسالة للطلاب"
                        allowfullscreen>
                </iframe>

                <h3>رسالة إلى الطلاب</h3>
                <p>كلمة تحفيزية من الأستاذ لجميع الطلاب في بداية العام الدراسي.</p>

                <button class="edit-video-btn" onclick="openVideoPopup(this)">
                    <i class="fas fa-edit"></i>
                    تعديل
                </button>
            </div>

            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/i59pw-1VHFc?si=XSdqs0Kssxsap8fE"
                        title="شرح مميز"
                        allowfullscreen>
                </iframe>

                <h3>شرح مميز</h3>
                <p>جزء من أحد الدروس لعرض أسلوب الشرح.</p>

                <button class="edit-video-btn" onclick="openVideoPopup(this)">
                    <i class="fas fa-edit"></i>
                    تعديل
                </button>
            </div>

            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/i59pw-1VHFc?si=XSdqs0Kssxsap8fE"
                        title="نصائح للمذاكرة"
                        allowfullscreen>
                </iframe>

                <h3>نصائح للمذاكرة</h3>
                <p>أفضل النصائح لتحقيق أعلى الدرجات في اللغة العربية.</p>

                <button class="edit-video-btn" onclick="openVideoPopup(this)">
                    <i class="fas fa-edit"></i>
                    تعديل
                </button>
            </div>

        </div>

    </div>
</section>

@section model{
    <div id="videoModal" class="modal">

        <div class="modal-content">

            <h2>تعديل الفيديو</h2>

            <label>رابط الفيديو</label>
            <input type="text" id="videoLink">

            <label>العنوان</label>
            <input type="text" id="videoTitle">

            <label>الوصف</label>
            <textarea id="videoDescription"></textarea>

            <div class="modal-buttons">
                <button onclick="saveVideo()">حفظ</button>
                <button onclick="closeVideoPopup()">إلغاء</button>
            </div>

        </div>

    </div>
}