@model Available_slot
@{
    Layout = "~/Views/Shared/_layoutadmin.cshtml";
    ViewData["Title"] = "اضافة مجموعة جديدة";
    int? Number_Of_day = ViewBag.Number_Of_day;
}

<section class="form-section">
    <h2>إضافة مجموعة جديدة</h2>

    <form asp-action="Create" method="post" id="mainForm">
        <div class="input-field-group">
            <label>اسم المجموعة</label>
            <input type="text" asp-for="Group_Name" required>
        </div>

        <div class="input-field-group">
            <label>المكان</label>
            <select asp-for="PlaceId" required>
                @foreach (var place in ViewBag.Places)
                {
                    <option value="@place.Id">@place.Name</option>
                }
            </select>
        </div>

        <div class="input-field-group">
            <label>الصف</label>
            <select asp-for="ClassId" required>
                @foreach (var cls in ViewBag.Classes)
                {
                    <option value="@cls.Id">@cls.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>عدد أيام الحضور في الأسبوع</label>
            <select name="Number_Of_day" onchange="window.location.href='?Number_Of_day=' + this.value">
                @for (int i = 1; i <= 7; i++)
                {
                    <!option value="@i" @(Number_Of_day == i ? "selected" : "")>@i أيام</!option>
                }
            </select>
        </div>

        <div id="daysContainer">
            @for (int i = 0; i < Number_Of_day; i++)
            {
                <div class="day-card">
                    <div class="day-title">اليوم @(i + 1)</div>
                    <div class="day-row">
                        <div class="day-field">
                            <label>اليوم</label>
                            <select name="SlotTimes[@i].Day">
                                <option value="السبت">السبت</option>
                                <option value="الأحد">الأحد</option>
                                <option value="الإثنين">الإثنين</option>
                                <option value="الثلاثاء">الثلاثاء</option>
                                <option value="الأربعاء">الأربعاء</option>
                                <option value="الخميس">الخميس</option>
                                <option value="الجمعة">الجمعة</option>
                            </select>
                        </div>
                        <div class="day-field">
                            <label>ميعاد الحصة</label>
                            <input type="time" name="SlotTimes[@i].Time" required>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="popup-actions-flex">
            <button type="submit" class="action-button">حفظ المجموعة</button>
            <a asp-action="Index" class="action-button" style="background:#ccc;color:#333; text-decoration:none; text-align:center;">إلغاء</a>
        </div>
    </form>
</section>
