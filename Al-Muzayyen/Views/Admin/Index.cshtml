@using Al_Muzayyen.Viewmodel
@model IndexVMAdmin
@{
    Layout = "~/Views/Shared/_layoutAdmin.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>
    /* ------------------------------------------------------------- */
    /* التنسيق الأساسي لشاشات الملف الشخصي والإحصائيات */
    /* ------------------------------------------------------------- */
    .profile-card {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 25px;
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
        margin-bottom: 20px;
    }

    .profile-image {
        position: relative;
        width: 110px;
        flex-shrink: 0;
    }

    .profile-image img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #d4a24c;
    }

    .change-image-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 50%;
        background: #d4a24c;
        color: #fff;
        border: 2px solid #fff;
        cursor: pointer;
        font-size: 14px;
        transition: .3s;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    .change-image-btn:hover {
        background: #bb8b39;
    }

    .profile-content {
        flex: 1;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .profile-info-block {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .profile-content h2 {
        color: #23395d;
        font-size: 22px;
        margin: 0;
    }

    .edit-profile-btn {
        background: #23395d;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        transition: .3s;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: auto;
    }

    .edit-profile-btn:hover {
        background: #1c304c;
    }

    .info-grid {
       display:none
    }

    .info-box {
        background: #f8f9fc;
        border-right: 4px solid #d4a24c;
        border-radius: 10px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .info-box i {
        font-size: 18px;
        color: #d4a24c;
    }

    .info-box span {
        display: block;
        color: #888;
        margin-bottom: 3px;
        font-size: 13px;
    }

    .info-box strong {
        color: #23395d;
        font-size: 15px;
    }

    .dashboard-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .metric-card {
        background: #fff;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,.04);
    }

    .metric-card h3 {
        font-size: 14px;
        color: #666;
        margin: 0 0 8px 0;
    }

    .metric-value {
        font-size: 24px;
        font-weight: bold;
        color: #23395d;
    }

    /* ------------------------------------------------------------- */
    /* CSS الخاص بالجدول والأزرار والنوافذ من الكود المقدم */
    /* ------------------------------------------------------------- */
    .section-header-block {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .section-header-block h2 {
        font-size: 1.4rem;
        color: var(--secondary-color, #23395d);
        margin: 0;
    }

    .table-responsive-container {
        width: 100%;
        overflow-x: auto;
        background-color: var(--white, #ffffff);
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border: 1px solid var(--border-color, #e2e8f0);
    }

    .data-display-table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
        min-width: 750px; /* ضمان عرض أدنى ممتاز للموبايل لمنع الضغط */
    }

    .data-display-table th {
        background-color: #fafbfe;
        color: var(--text-muted, #64748b);
        padding: 15px;
        font-weight: 600;
        font-size: 0.9rem;
        border-bottom: 2px solid var(--border-color, #e2e8f0);
        white-space: nowrap; /* منع انكسار عناوين الأعمدة */
    }

    .data-display-table td {
        padding: 15px;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
        font-size: 0.95rem;
        white-space: nowrap; /* منع انكسار نصوص الخلايا والأزرار */
        vertical-align: middle;
    }

    .data-display-table tr:last-child td {
        border-bottom: none;
    }

    /* الأزرار والأيقونات */
    .action-icon-btn {
        border: none;
        background: none;
        cursor: pointer;
        font-size: 1.1rem;
        margin-left: 8px;
        transition: transform 0.2s, color 0.2s;
        padding: 4px 8px;
        border-radius: 6px;
    }

    .action-icon-btn:hover {
        transform: scale(1.15);
    }

    .btn-view-reason {
        color: var(--primary-color, #d4a24c);
        background-color: rgba(212, 162, 76, 0.1);
    }

    .btn-approve-icon {
        color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
    }

    .btn-reject-icon {
        color: #ef4444;
        background-color: rgba(239, 68, 68, 0.1);
    }

    /* الشارات (Badges) */
    .status-badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-badge.pending {
        background: rgba(245, 158, 11, 0.1);
        color: #d97706;
    }

    .status-badge.approved {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .status-badge.rejected {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    /* ------------------------------------------------------------- */
    /* النوافذ المنبثقة (Modals) بحسب الكلاسات الجديدة */
    /* ------------------------------------------------------------- */
    .custom-popup-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        padding: 20px;
        opacity: 0;
        transition: opacity 0.25s ease-in-out;
    }

    .custom-popup-overlay.active {
        display: flex;
        opacity: 1;
    }

    .popup-window-content {
        background-color: var(--white, #ffffff);
        border-radius: 12px;
        width: 100%;
        max-width: 500px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        direction: rtl;
        text-align: right;
    }

    .popup-window-content h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: var(--secondary-color, #23395d);
        font-size: 1.25rem;
    }

    .input-field-group {
        margin-bottom: 15px;
    }

    .input-field-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        color: #475569;
    }

    .input-field-group input,
    .input-field-group select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-color, #cbd5e1);
        border-radius: 6px;
        font-size: 0.95rem;
        outline: none;
        box-sizing: border-box;
    }

    .input-field-group input:focus,
    .input-field-group select:focus {
        border-color: var(--primary-color, #d4a24c);
    }

    .popup-actions-flex {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        justify-content: flex-end;
    }

    .btn-submit {
        background-color: var(--primary-color, #d4a24c);
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    .btn-close {
        background-color: #e2e8f0;
        color: #475569;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

    /* شاشات الموبايل والتابلت */
    @@media (max-width: 992px) {
        .profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .profile-content {
            flex-direction: column;
            width: 100%;
        }

        .edit-profile-btn {
            margin: 10px 0 0 0;
            width: 100%;
            justify-content: center;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<section id="overview-section">

    <!-- كارت البيانات الشخصية -->
    <div class="profile-card">
        <div class="profile-image">
            <img id="admin-photo" src="@(string.IsNullOrEmpty(Model?.Admin?.ImageUrl) ? "/images/image.png" : Model.Admin.ImageUrl)" alt="Admin">
            <button type="button" class="change-image-btn" title="تغيير الصورة" onclick="openImageModal()">
                <i class="fa-solid fa-camera"></i>
            </button>
        </div>

        <div class="profile-content">
            <div class="profile-info-block">
                <h2 id="admin-name">@(Model?.Admin?.Name ?? "الأستاذ")</h2>
                
                <div class="info-grid" >
                    <div class="info-box">
                        <i class="fa-solid fa-phone"></i>
                        <div>
                            <span>رقم الهاتف</span>
                            <strong id="admin-phone">@(Model?.Admin?.PhoneNumber ?? "غير محدد")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" class="edit-profile-btn" onclick="openEditModal()">
                <i class="fa-solid fa-pen"></i>
                تعديل البيانات
            </button>
        </div>
    </div>

    <!-- كروت الإحصائيات -->
    <div class="dashboard-stats-grid">
        <div class="metric-card">
            <h3>إجمالي الطلاب</h3>
            <div class="metric-value">@Model.StudentsCount</div>
        </div>
        <div class="metric-card">
            <h3>عدد المجموعات</h3>
            <div class="metric-value">@Model.GroupsCount</div>
        </div>
        <div class="metric-card">
            <h3>عدد الفصول</h3>
            <div class="metric-value">@Model.ClassesCount</div>
        </div>
    </div>

    <!-- ============================================================= -->
    <!-- قسم جدول طلبات تغيير المجموعة بالتصميم الجديد -->
    <!-- ============================================================= -->
    <div class="section-header-block">
        <h2><i class="fa-solid fa-arrows-rotate" style="color: var(--primary-color, #d4a24c);"></i> طلبات تغيير المجموعة</h2>
    </div>

    <div class="table-responsive-container">
        <table class="data-display-table">
            <thead>
                <tr>
                    <th>اسم الطالب</th>
                    <th>الفرع / المقر</th>
                    <th>الصف الدراسي</th>
                    <th>المجموعة المطلوبة</th>
                    <th style="text-align: center;">السبب</th>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                    <th style="text-align: center;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                <!-- صف طلب قيد الانتظار -->
                <tr>
                    <td><strong>أحمد محمد علي</strong></td>
                    <td>سنتر النور</td>
                    <td>الصف الأول الثانوي</td>
                    <td>مجموعة A (السبت - 04:00 م)</td>
                    <td style="text-align: center;">
                        <!-- زر صغير جداً كأيقونة مع توضيح Title -->
                        <button type="button" class="action-icon-btn btn-view-reason" title="عرض سبب التحويل" onclick="openReasonModal('أحمد محمد علي', 'تعارض المواعيد مع درس الفيزياء الخاص بالمدرسة')">
                            <i class="fa-solid fa-file-lines"></i>
                        </button>
                    </td>
                    <td>2026/07/24</td>
                    <td><span class="status-badge pending">قيد الانتظار</span></td>
                    <td style="text-align: center;">
                        <form asp-action="ApproveGroupRequest" asp-controller="Admin" method="post" style="display:inline;">
                            <input type="hidden" name="requestId" value="1" />
                            <button type="submit" class="action-icon-btn btn-approve-icon" title="قبول الطلب">
                                <i class="fa-solid fa-check"></i>
                            </button>
                        </form>
                        <form asp-action="RejectGroupRequest" asp-controller="Admin" method="post" style="display:inline;">
                            <input type="hidden" name="requestId" value="1" />
                            <button type="submit" class="action-icon-btn btn-reject-icon" title="رفض الطلب">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </form>
                    </td>
                </tr>

                <!-- صف طلب مقبول -->
                <tr>
                    <td><strong>محمود حسن</strong></td>
                    <td>المقر الرئيسي</td>
                    <td>الصف الثاني الثانوي</td>
                    <td>مجموعة B (الأحد والثلاثاء)</td>
                    <td style="text-align: center;">
                        <button type="button" class="action-icon-btn btn-view-reason" title="عرض سبب التحويل" onclick="openReasonModal('محمود حسن', 'ظروف صحية طارئة تمنع الحضور مساءً')">
                            <i class="fa-solid fa-file-lines"></i>
                        </button>
                    </td>
                    <td>2026/07/22</td>
                    <td><span class="status-badge approved">تمت الموافقة</span></td>
                    <td style="text-align: center;">
                        <span style="color: #94a3b8; font-size: 0.85rem;">مكتمل</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</section>

<!-- ============================================================= -->
<!-- النوافذ المنبثقة (Modals) بناءً على CSS الكلاسات الجديدة -->
<!-- ============================================================= -->

<!-- 1. نافذة عرض سبب التحويل -->
<div class="custom-popup-overlay" id="reasonModal">
    <div class="popup-window-content">
        <h3 id="reason-student-name">سبب طلب التحويل</h3>
        <div class="input-field-group">
            <p id="reason-text-content" style="background: #f8fafc; padding: 15px; border-radius: 8px; color: #334155; font-size: 0.95rem; line-height: 1.6; border: 1px solid #e2e8f0; margin: 0;"></p>
        </div>
        <div class="popup-actions-flex">
            <button type="button" class="btn-close" onclick="closeReasonModal()">إغلاق</button>
        </div>
    </div>
</div>

<!-- 2. نافذة تغيير الصورة الشخصية -->
<div class="custom-popup-overlay" id="imageModal">
    <div class="popup-window-content">
        <h3>تغيير الصورة الشخصية</h3>
        <form asp-action="UpdateProfileImage" asp-controller="Admin" method="post" enctype="multipart/form-data">
            <div class="input-field-group">
                <label>اختر صورة جديدة من جهازك</label>
                <input type="file" name="imageFile" id="new-image-file" accept="image/*" required>
            </div>
            <div class="popup-actions-flex">
                <button type="submit" class="btn-submit">حفظ الصورة</button>
                <button type="button" class="btn-close" onclick="closeImageModal()">إلغاء</button>
            </div>
        </form>
    </div>
</div>

<!-- 3. نافذة تعديل البيانات -->
<div class="custom-popup-overlay" id="editModal">
    <div class="popup-window-content">
        <h3>تعديل البيانات الشخصية</h3>
        <form asp-action="UpdateProfileData" asp-controller="Admin" method="post">
            <div class="input-field-group">
                <label>الاسم الكامل</label>
                <input type="text" name="Name" id="modal-input-name" required>
            </div>

            <div class="input-field-group">
                <label>رقم الهاتف</label>
                <input type="text" name="PhoneNumber" id="modal-input-phone" required>
            </div>

            <div class="popup-actions-flex">
                <button type="submit" class="btn-submit">حفظ التعديلات</button>
                <button type="button" class="btn-close" onclick="closeEditModal()">إلغاء</button>
            </div>
        </form>
    </div>
</div>

<script>
    // التحكم بفتح وإغلاق نافذة سبب التحويل
    function openReasonModal(studentName, reasonText) {
        document.getElementById("reason-student-name").innerText = "سبب تحويل: " + studentName;
        document.getElementById("reason-text-content").innerText = reasonText;
        document.getElementById("reasonModal").classList.add("active");
    }

    function closeReasonModal() {
        document.getElementById("reasonModal").classList.remove("active");
    }

    // التحكم بفتح وإغلاق نافذة رفع الصورة
    function openImageModal() {
        document.getElementById("new-image-file").value = "";
        document.getElementById("imageModal").classList.add("active");
    }

    function closeImageModal() {
        document.getElementById("imageModal").classList.remove("active");
    }

    // التحكم بفتح وإغلاق نافذة تعديل البيانات
    function openEditModal() {
        document.getElementById("modal-input-name").value = document.getElementById("admin-name").innerText.trim();
        document.getElementById("modal-input-phone").value = document.getElementById("admin-phone").innerText.trim();
        document.getElementById("editModal").classList.add("active");
    }

    function closeEditModal() {
        document.getElementById("editModal").classList.remove("active");
    }
</script>