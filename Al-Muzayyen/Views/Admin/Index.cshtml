@using Al_Muzayyen.Viewmodel
@model IndexVMAdmin
@{
    Layout = "~/Views/Shared/_layoutAdmin.cshtml";
    ViewData["Title"] = "Dashbord";
}


<!-- قسم النظرة العامة -->
<section id="overview-section">
    <div class="dashboard-stats-grid">
        <div class="metric-card">
            <h3>إجمالي الطلاب</h3>
            <div class="metric-value" id="total-students">@Model.StudentsCount</div>
        </div>
        <div class="metric-card">
            <h3>عدد المجموعات</h3>
            <div class="metric-value" id="total-groups">@Model.GroupsCount</div>
        </div>
        <div class="metric-card">
            <h3>عدد الفصول</h3>
            <div class="metric-value" id="total-classes">@Model.ClassesCount</div>
        </div>
    </div>
</section>