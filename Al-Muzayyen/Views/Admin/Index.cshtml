@{
    ViewData["Title"] = "لوحة التحكم - المعلم";
    Layout = "~/Views/Shared/_layoutadmin.cshtml";
}
<style>
    /* ------------------------------------------------------------- */
    /* التنسيق الأساسي لشاشات الملف الشخصي والإحصائيات */
    /* ------------------------------------------------------------- */
    .dashboard-container {
        padding: 10px;
        font-family: inherit;
        box-sizing: border-box;
    }

    .profile-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 25px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        margin-bottom: 24px;
        border: 1px solid #f1f5f9;
    }

    .profile-image {
        position: relative;
        width: 100px;
        height: 100px;
        flex-shrink: 0;
    }

    .profile-image img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #d4a24c;
    }

    .change-image-btn {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 50%;
        background: #d4a24c;
        color: #fff;
        border: 2px solid #fff;
        cursor: pointer;
        font-size: 13px;
        transition: all .3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }

    .change-image-btn:hover { background: #bb8b39; transform: scale(1.05); }

    .profile-content {
        flex: 1;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .profile-info-block {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .profile-content h2 {
        color: #1e293b;
        font-size: 22px;
        font-weight: 700;
        margin: 0;
    }

    .info-grid {
        display: block;
        margin-top: 5px;
    }

    .info-box {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 14px;
    }

    .edit-profile-btn {
        background: #23395d;
        color: #fff;
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: all .3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .edit-profile-btn:hover { background: #1c304c; transform: translateY(-2px); }

    .dashboard-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .metric-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        border: 1px solid #f1f5f9;
        transition: transform .3s ease;
    }

    .metric-card:hover { transform: translateY(-3px); }

    .metric-card h3 {
        font-size: 14px;
        color: #64748b;
        margin: 0 0 10px 0;
        font-weight: 600;
    }

    .metric-value {
        font-size: 28px;
        font-weight: 800;
        color: #23395d;
    }

    /* ------------------------------------------------------------- */
    /* نظام تبويبات الإشعارات والطلبات */
    /* ------------------------------------------------------------- */
    .notifications-container {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .notification-tabs-header {
        display: flex;
        flex-wrap: wrap;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .tab-btn {
        flex: 1;
        min-width: 160px;
        padding: 16px 20px;
        border: none;
        background: transparent;
        font-size: 0.95rem;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        position: relative;
    }

    .tab-btn.active {
        color: #23395d;
        background: #ffffff;
    }

    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 3px;
        background-color: #d4a24c;
    }

    .badge-count {
        background: #ef4444;
        color: #fff;
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 12px;
        font-weight: 700;
    }

    .tab-content {
        display: none;
        padding: 20px;
    }

    .tab-content.active { display: block; }

    /* حاوية التمرير للجدول لمنع خروج العناصر */
    .table-responsive-container {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .data-display-table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
    }

    .data-display-table th {
        background-color: #f8fafc;
        color: #475569;
        padding: 14px 16px;
        font-weight: 600;
        font-size: 0.88rem;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .data-display-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.92rem;
        color: #334155;
        vertical-align: middle;
        white-space: nowrap;
    }

    .action-icon-btn {
        border: none;
        background: none;
        cursor: pointer;
        font-size: 1rem;
        margin-left: 4px;
        padding: 8px 12px;
        border-radius: 8px;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .action-icon-btn:hover { transform: translateY(-2px); }
    .btn-view-reason { color: #d4a24c; background: rgba(212, 162, 76, 0.12); }
    .btn-approve-icon { color: #10b981; background: rgba(16, 185, 129, 0.12); }
    .btn-reject-icon { color: #ef4444; background: rgba(239, 68, 68, 0.12); }

    /* Skeleton Loading effect */
    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 6px;
        display: inline-block;
    }

    .skeleton-text { height: 18px; width: 80%; }

    @@keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* ------------------------------------------------------------- */
    /* النوافذ المنبثقة (Modals) */
    /* ------------------------------------------------------------- */
    .custom-popup-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(4px);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .custom-popup-overlay.active { display: flex; }

    .popup-window-content {
        background-color: #ffffff;
        border-radius: 16px;
        width: 100%;
        max-width: 500px;
        padding: 24px;
        direction: rtl;
        text-align: right;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .popup-window-content h3 {
        margin-top: 0;
        margin-bottom: 18px;
        color: #1e293b;
        font-size: 1.25rem;
    }

    .input-field-group {
        margin-bottom: 15px;
    }

    .input-field-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #475569;
    }

    .input-field-group input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        box-sizing: border-box;
    }

    .input-field-group input:focus { border-color: #d4a24c; }

    .popup-actions-flex { display: flex; gap: 10px; margin-top: 20px; justify-content: flex-end; }
    .btn-submit { background-color: #d4a24c; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; }
    .btn-close { background-color: #f1f5f9; color: #475569; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; }

    /* ------------------------------------------------------------- */
    /* تحسين العرض والتجاوب الشامل للهواتف (Responsive Mobile UI) */
    @@media (max-width: 768px) {
    .dashboard-container { 
        padding: 5px; 
    }

    .profile-card { 
        flex-direction: column; 
        text-align: center; 
        padding: 16px; 
    }

    .profile-content { 
        flex-direction: column; 
        width: 100%; 
    }

    .edit-profile-btn { 
        width: 100%; 
        justify-content: center; 
    }

    .dashboard-stats-grid { 
        grid-template-columns: 1fr; 
        gap: 12px; 
    }

    /* 1. جعل أزرار التبويبات تحت بعضها */
    .notification-tabs-header {
        flex-direction: column;
        width: 100%;
    }

    .tab-btn {
        width: 100%;
        padding: 14px;
        font-size: 0.9rem;
        justify-content: space-between; /* توزيع النص والأيقونة والرقم بالتساوي */
        border-bottom: 1px solid #e2e8f0;
    }

    .tab-btn.active::after {
        height: 100%;
        width: 4px;
        right: 0;
        left: auto;
        bottom: 0;
    }

    /* 2. الإبقاء على شكل الجدول الافتراضي مع تمكين التمرير الأفقي */
    .table-responsive-container {
        width: 100%;
        overflow-x: auto; /* يتيح التمرير لليمين واليسار */
        -webkit-overflow-scrolling: touch;
    }

    .data-display-table {
        display: table !important; /* إلغاء خاصية display: block */
        width: 100%;
        min-width: 650px; /* تحديد أدنى عرض للجدول ليحافظ على شكله بدون انكماش */
    }

    .data-display-table thead {
        display: table-header-group !important; /* إرجاع رؤوس الجدول */
        position: static !important;
    }

    .data-display-table tbody {
        display: table-row-group !important;
    }

    .data-display-table tr {
        display: table-row !important;
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
    }

    .data-display-table th, 
    .data-display-table td {
        display: table-cell !important; /* إرجاع الخلايا لشكلها الطبيعي */
        padding: 10px 12px !important;
        white-space: nowrap; /* منع التفاف النصوص */
        text-align: right !important;
        border-bottom: 1px solid #f1f5f9 !important;
    }

    /* إخفاء تسمية data-label لأن رؤوس الجدول ستظهر طبيعياً */
    .data-display-table td::before {
        content: none !important;
    }
}
</style>

<div class="dashboard-container">
    <section id="overview-section">

        <!-- كارت البيانات الشخصية -->
        <div class="profile-card">
            <div class="profile-image">
                <img id="admin-photo" src="/images/image.png" alt="Admin">
                <button type="button" class="change-image-btn" title="تغيير الصورة" onclick="openImageModal()">
                    <i class="fa-solid fa-camera"></i>
                </button>
            </div>

            <div class="profile-content">
                <div class="profile-info-block">
                    <h2 id="admin-name"><span class="skeleton skeleton-text" style="width: 150px;"></span></h2>
                    <div class="info-grid">
                        <div class="info-box">
                            <i class="fa-solid fa-phone"></i>
                            <span>رقم الهاتف:</span>
                            <strong id="admin-phone"><span class="skeleton skeleton-text" style="width: 100px;"></span></strong>
                        </div>
                    </div>
                </div>

                <button type="button" class="edit-profile-btn" onclick="openEditModal()">
                    <i class="fa-solid fa-pen"></i>
                    تعديل البيانات
                </button>
            </div>
        </div>

        <!-- كروت الإحصائيات -->
        <div class="dashboard-stats-grid">
            <div class="metric-card">
                <h3>إجمالي الطلاب</h3>
                <div class="metric-value" id="students-count"><span class="skeleton skeleton-text" style="width: 50px;"></span></div>
            </div>
            <div class="metric-card">
                <h3>عدد المجموعات</h3>
                <div class="metric-value" id="groups-count"><span class="skeleton skeleton-text" style="width: 50px;"></span></div>
            </div>
            <div class="metric-card">
                <h3>عدد الفصول</h3>
                <div class="metric-value" id="classes-count"><span class="skeleton skeleton-text" style="width: 50px;"></span></div>
            </div>
        </div>

        <!-- مركز الإشعارات والطلبات -->
        <div class="notifications-container">
            <div class="notification-tabs-header">
                <button class="tab-btn active" onclick="switchTab('booking-requests-tab', this)">
                    <i class="fa-solid fa-user-clock"></i> طلبات تأكيد الحجز 
                    <span class="badge-count" id="pending-booking-badge">0</span>
                </button>
                <button class="tab-btn" onclick="switchTab('group-requests-tab', this)">
                    <i class="fa-solid fa-arrows-rotate"></i> طلبات تغيير المجموعات 
                    <span class="badge-count" id="group-change-badge">0</span>
                </button>
            </div>

            <!-- 1. تبويب طلبات الحجز الجديدة -->
            <div id="booking-requests-tab" class="tab-content active">
                <div class="table-responsive-container">
                    <table class="data-display-table">
                        <thead>
                            <tr>
                                <th>اسم الطالب</th>
                                <th>هاتف الطالب</th>
                                <th>هاتف ولي الأمر</th>
                                <th>الفرع</th>
                                <th>الصف</th>
                                <th>المجموعة</th>
                                <th>التاريخ</th>
                                <th style="text-align: center;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="pending-bookings-table-body">
                            <tr><td colspan="8" style="text-align:center; padding: 20px;"><span class="skeleton skeleton-text" style="width: 90%;"></span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. تبويب طلبات تغيير المجموعات -->
            <div id="group-requests-tab" class="tab-content">
                <div class="table-responsive-container">
                    <table class="data-display-table">
                        <thead>
                            <tr>
                                <th>اسم الطالب</th>
                                <th>الفرع</th>
                                <th>الصف</th>
                                <th>المجموعة المطلوبة</th>
                                <th style="text-align: center;">السبب</th>
                                <th>التاريخ</th>
                                <th style="text-align: center;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="group-requests-table-body">
                            <tr><td colspan="7" style="text-align:center; padding: 20px;"><span class="skeleton skeleton-text" style="width: 90%;"></span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ============================================================= -->
<!-- النوافذ المنبثقة (Modals) بناءً على المطلوب بالضبط -->
<!-- ============================================================= -->

<!-- 1. نافذة عرض سبب التحويل -->
<div class="custom-popup-overlay" id="reasonModal">
    <div class="popup-window-content">
        <h3 id="reason-student-name">سبب طلب التحويل</h3>
        <div class="input-field-group">
            <p id="reason-text-content" style="background: #f8fafc; padding: 15px; border-radius: 8px; color: #334155; font-size: 0.95rem; line-height: 1.6; border: 1px solid #e2e8f0; margin: 0;"></p>
        </div>
        <div class="popup-actions-flex">
            <button type="button" class="btn-close" onclick="closeReasonModal()">إغلاق</button>
        </div>
    </div>
</div>

<!-- 2. نافذة تغيير الصورة الشخصية -->
<div class="custom-popup-overlay" id="imageModal">
    <div class="popup-window-content">
        <h3>تغيير الصورة الشخصية</h3>
        <form asp-action="UpdateProfileImage" asp-controller="Admin" method="post" enctype="multipart/form-data">
            <div class="input-field-group">
                <label>اختر صورة جديدة من جهازك</label>
                <input type="file" name="imageFile" id="new-image-file" accept="image/*" required>
            </div>
            <div class="popup-actions-flex">
                <button type="submit" class="btn-submit">حفظ الصورة</button>
                <button type="button" class="btn-close" onclick="closeImageModal()">إلغاء</button>
            </div>
        </form>
    </div>
</div>

<!-- 3. نافذة تعديل البيانات -->
<div class="custom-popup-overlay" id="editModal">
    <div class="popup-window-content">
        <h3>تعديل البيانات الشخصية</h3>
        <form asp-action="UpdateProfileData" asp-controller="Admin" method="post">
            <div class="input-field-group">
                <label>الاسم الكامل</label>
                <input type="text" name="Name" id="modal-input-name" required>
            </div>

            <div class="input-field-group">
                <label>رقم الهاتف</label>
                <input type="text" name="PhoneNumber" id="modal-input-phone" required>
            </div>

            <div class="popup-actions-flex">
                <button type="submit" class="btn-submit">حفظ التعديلات</button>
                <button type="button" class="btn-close" onclick="closeEditModal()">إلغاء</button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================= -->
<!-- JavaScript -->
<!-- ============================================================= -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        loadDashboardStats();
        loadPendingBookings();
        loadGroupChangeRequests();
    });

    // التنقل بين التبويبات
    function switchTab(tabId, btn) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

        document.getElementById(tabId).classList.add('active');
        btn.classList.add('active');
    }

    // جلب البيانات والإحصائيات ورقم الهاتف
    function loadDashboardStats() {
        fetch('/Admin/GetDashboardStats')
            .then(res => res.json())
            .then(data => {
                document.getElementById('students-count').innerText = data.studentsCount || 0;
                document.getElementById('groups-count').innerText = data.groupsCount || 0;
                document.getElementById('classes-count').innerText = data.classesCount || 0;

                if (data.admin) {
                    document.getElementById('admin-name').innerText = data.admin.name || data.admin.Name || "الأستاذ";
                    
                    // حل مشكلة رقم الهاتف بجلب القيمة بأكثر من مسمى احتراطي
                    const phoneValue = data.admin.phone || data.admin.phoneNumber || data.admin.Phone || data.admin.PhoneNumber || "غير محدد";
                    document.getElementById('admin-phone').innerText = phoneValue;

                    if (data.admin.imageUrl || data.admin.ImageUrl) {
                        document.getElementById('admin-photo').src = data.admin.imageUrl || data.admin.ImageUrl;
                    }
                }
            }).catch(err => console.error("Error loading stats:", err));
    }

    // جلب طلبات الحجز المعلقة
    function loadPendingBookings() {
        fetch('/Admin/GetPendingBookings')
            .then(res => res.json())
            .then(data => {
                const tbody = document.getElementById('pending-bookings-table-body');
                document.getElementById('pending-booking-badge').innerText = data.length;
                tbody.innerHTML = '';

                if (data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; color:#94a3b8; padding: 25px;">لا توجد طلبات تأكيد حجز جديدة</td></tr>`;
                    return;
                }

                data.forEach(item => {
                    tbody.innerHTML += `
                        <tr>
                            <td data-label="اسم الطالب"><strong>${item.studentName}</strong></td>
                            <td data-label="هاتف الطالب">${item.stdPhone}</td>
                            <td data-label="هاتف ولي الأمر">${item.parentPhone}</td>
                            <td data-label="الفرع">${item.placeName}</td>
                            <td data-label="الصف">${item.className}</td>
                            <td data-label="المجموعة">${item.groupName}</td>
                            <td data-label="التاريخ">${item.createdAt}</td>
                            <td data-label="الإجراءات" style="text-align: center;">
                                <button class="action-icon-btn btn-approve-icon" title="تأكيد الحجز" onclick="confirmBooking(${item.id})">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <button class="action-icon-btn btn-reject-icon" title="رفض وحذف الطالب" onclick="rejectBooking(${item.id})">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </td>
                        </tr>`;
                });
            });
    }

    // جلب طلبات تغيير المجموعات
    function loadGroupChangeRequests() {
        fetch('/Admin/GetGroupChangeRequests')
            .then(res => res.json())
            .then(data => {
                const tbody = document.getElementById('group-requests-table-body');
                document.getElementById('group-change-badge').innerText = data.length;
                tbody.innerHTML = '';

                if (data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#94a3b8; padding: 25px;">لا توجد طلبات تغيير مجموعة حالياً</td></tr>`;
                    return;
                }

                data.forEach(item => {
                    tbody.innerHTML += `
                        <tr>
                            <td data-label="اسم الطالب"><strong>${item.studentName}</strong></td>
                            <td data-label="الفرع">${item.placeName}</td>
                            <td data-label="الصف">${item.className}</td>
                            <td data-label="المجموعة المطلوبة">${item.requestedGroup}</td>
                            <td data-label="السبب" style="text-align: center;">
                                <button class="action-icon-btn btn-view-reason" title="عرض السبب" onclick="openReasonModal('${item.studentName}', '${item.reason}')">
                                    <i class="fa-solid fa-file-lines"></i>
                                </button>
                            </td>
                            <td data-label="التاريخ">${item.requestDate}</td>
                            <td data-label="الإجراءات" style="text-align: center;">
                                <button class="action-icon-btn btn-approve-icon" title="قبول الطلب" onclick="approveGroupRequest(${item.id})">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <button class="action-icon-btn btn-reject-icon" title="رفض الطلب" onclick="rejectGroupRequest(${item.id})">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </td>
                        </tr>`;
                });
            });
    }

    /* ------------------------------------------------------------- */
    /* دوال التحكم بفتح وإغلاق الـ Modals المطلوبة بالأسماء الدقيقة */
    /* ------------------------------------------------------------- */

    // 1. Modal تعديل البيانات (editModal)
    function openEditModal() {
        document.getElementById('modal-input-name').value = document.getElementById('admin-name').innerText.trim();
        document.getElementById('modal-input-phone').value = document.getElementById('admin-phone').innerText.trim();
        document.getElementById('editModal').classList.add('active');
    }

    function closeEditModal() {
        document.getElementById('editModal').classList.remove('active');
    }

    // 2. Modal تغيير الصورة (imageModal)
    function openImageModal() {
        document.getElementById('imageModal').classList.add('active');
    }

    function closeImageModal() {
        document.getElementById('imageModal').classList.remove('active');
    }

    // 3. Modal عرض السبب (reasonModal)
    function openReasonModal(studentName, reasonText) {
        document.getElementById("reason-student-name").innerText = "سبب طلب تحويل: " + studentName;
        document.getElementById("reason-text-content").innerText = reasonText || "لا يوجد سبب مذكور";
        document.getElementById("reasonModal").classList.add("active");
    }

    function closeReasonModal() {
        document.getElementById('reasonModal').classList.remove('active');
    }

    /* ------------------------------------------------------------- */
    /* دوال الموافقة والرفض */
    /* ------------------------------------------------------------- */
    function confirmBooking(id) {
        fetch(`/Admin/ConfirmBooking?studentId=${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    loadPendingBookings();
                    loadDashboardStats();
                }
            });
    }

    function rejectBooking(id) {
        if (!confirm("هل أنت تأكد من رفض الطالب؟ سيتم حذف حسابه نهائياً!")) return;

        fetch(`/Admin/RejectBooking?studentId=${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) loadPendingBookings();
            });
    }

    function approveGroupRequest(id) {
        fetch(`/Admin/ApproveGroupRequest?requestId=${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) loadGroupChangeRequests();
            });
    }

    function rejectGroupRequest(id) {
        fetch(`/Admin/RejectGroupRequest?requestId=${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.success) loadGroupChangeRequests();
            });
    }
</script>