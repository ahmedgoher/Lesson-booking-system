@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    // أو _TeacherLayout حسب ما بتستخدم
    ViewData["Title"] = "Group Management";
}
<link rel="stylesheet" href="~/css/styleadmin.css">

<style>
    /* تنسيقات إضافية بسيطة للـ Popups و الكروت الإحصائية تتطابق مع التصميم */
    .group-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card-box {
        background: var(--card-bg, #fff);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--border-color, #e2e8f0);
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.05));
    }

        .stat-card-box i {
            font-size: 28px;
            color: var(--primary-color, #c5a059);
            background: var(--bg-alt-2, #f1f5f9);
            padding: 15px;
            border-radius: 10px;
        }

    .stat-card-info h3 {
        font-size: 14px;
        color: var(--text-muted, #64748b);
        margin-bottom: 5px;
    }

    .stat-card-info p {
        font-size: 20px;
        font-weight: bold;
        color: var(--text-color, #1e293b);
        margin: 0;
    }

    .header-with-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-main-action {
        background-color: var(--primary-color, #c5a059);
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
    }

        .btn-main-action:hover {
            background-color: var(--primary-hover, #b08d4a);
        }

    /* Modal Styling */
    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--overlay-bg, rgba(0, 0, 0, 0.6));
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

        .custom-modal-overlay.active {
            display: flex;
        }

    .custom-modal-content {
        background: var(--card-bg, #fff);
        border-radius: 12px;
        width: 90%;
        max-width: 650px;
        padding: 20px;
        max-height: 85vh;
        overflow-y: auto;
    }

    .modal-header-block {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
    }

    .close-modal-btn {
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        color: var(--text-muted, #64748b);
    }

    .filter-inputs-container {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }

    .form-control-custom {
        width: 100%;
        padding: 10px;
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 8px;
        outline: none;
    }
</style>

<div class="group-management-content" style="padding: 20px 0;">

    <!-- 1. الهيدر والإحصائيات -->
    <div class="section-header-block">
        <h2>إدارة المجموعة: مجموعة أبطال الرياضيات (أ)</h2>
    </div>

    <div class="group-stats-grid">

        <div class="stat-card-box">
            <i class="fas fa-user-graduate"></i>
            <div class="stat-card-info">
                <h3>عدد الطلاب</h3>
                <p>45 طالب</p>
            </div>
        </div>

         
        <div class="stat-card-box">
            <i class="fas fa-video"></i>
            <div class="stat-card-info">
                <h3>عدد الفيديوهات</h3>
                <p>12 فيديو</p>
            </div>
        </div>
        <div class="stat-card-box">
            <i class="fas fa-file-signature"></i>
            <div class="stat-card-info">
                <h3>عدد الامتحانات</h3>
                <p>5 امتحانات</p>
            </div>
        </div>
    </div>

   
    <!-- 3. قسم الامتحانات والاختبارات -->
    <div class="exams-content" style="margin-bottom: 40px;">
        <div class="section-header-block header-with-btn">
            <h2>امتحانات المجموعة</h2>
            <button class="btn-main-action" onclick="openModal('addExamModal')">
                <i class="fas fa-plus"></i> إضافة امتحان للمجموعة
            </button>
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>اسم الامتحان</th>
                        <th>تاريخ الإضافة</th>
                        <th>عدد الأسئلة</th>
                        <th>نتائج الطلاب</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>امتحان منتصف الفصل - الرياضيات</td>
                        <td>2026-08-10</td>
                        <td>20 سؤال</td>
                        <td>
                            <button class="action-icon-btn" onclick="openModal('examResultsModal')" title="عرض النتائج">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>اختبار قصير - التفاضل والتكامل</td>
                        <td>2026-07-25</td>
                        <td>10 أسئلة</td>
                        <td>
                            <button class="action-icon-btn" onclick="openModal('examResultsModal')" title="عرض النتائج">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. قسم الملازم والمذكرات (معدّل ليكون كجدول) -->
    <div class="materials-content">
        <div class="section-header-block header-with-btn">
            <h2>الملازم والمذكرات المرفوعة</h2>
            <button class="btn-main-action" onclick="openModal('addMaterialModal')">
                <i class="fas fa-upload"></i> إضافة ملزمة / مذكرة
            </button>
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>عنوان الملزمة</th>
                        <th>الوصف</th>
                        <th>تاريخ الإضافة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>ملزمة الرياضيات - الفصل الأول</td>
                        <td>ملخص شامل لمادة الرياضيات للفصل الدراسي الأول.</td>
                        <td>2026-08-01</td>
                        <td>
                            <button class="action-icon-btn" title="تحميل">
                                <i class="fas fa-download"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>ملاحظات وتمارين التفاضل</td>
                        <td>مسائل إضافية محلولة بالكامل مخصصة لهذه المجموعة.</td>
                        <td>2026-07-15</td>
                        <td>
                            <button class="action-icon-btn" title="تحميل">
                                <i class="fas fa-download"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>كتاب الكيمياء العضوية</td>
                        <td>الكتاب المقرر لمادة الكيمياء العضوية.</td>
                        <td>2026-07-01</td>
                        <td>
                            <button class="action-icon-btn" title="تحميل">
                                <i class="fas fa-download"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. قسم المحاضرات والدروس (الفيديوهات المرفوعة للمجموعة) -->
    <!-- 2. قسم المحاضرات والدروس (الفيديوهات المرفوعة للمجموعة) -->
    <div class="videos-content" style="margin-bottom: 40px; margin-top: 40px;">
        <div class="section-header-block header-with-btn">
            <h2>الفيديوهات المرفوعة للمجموعة</h2>
            <button class="btn-main-action" onclick="openModal('addVideoModal')">
                <i class="fas fa-video"></i> إضافة فيديو جديد
            </button>
        </div>

        <div class="videos-grid">
            <!-- الفيديوهات الحالية... -->
            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" frameborder="0" allowfullscreen></iframe>
                <h3>شرح أساسيات التفاضل</h3>
                <p>محاضرة تغطي المفاهيم الأساسية للتفاضل مع أمثلة محلولة.</p>
            </div>
            <!-- ... باقي الفيديوهات ... -->
        </div>
    </div>


</div>

<!-- ================= POPUPS / MODALS ================= -->
<!-- Popup 1: نتائج الطلاب للامتحان -->
<div class="custom-modal-overlay" id="examResultsModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>نتائج طلاب المجموعة في الامتحان</h3>
            <button class="close-modal-btn" onclick="closeModal('examResultsModal')">&times;</button>
        </div>
        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>اسم الطالب</th>
                        <th>الدرجة</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>أحمد محمد علي</td>
                        <td>95/100</td>
                        <td><span style="color: green; font-weight: bold;">مكتمل</span></td>
                    </tr>
                    <tr>
                        <td>سارة محمود</td>
                        <td>88/100</td>
                        <td><span style="color: green; font-weight: bold;">مكتمل</span></td>
                    </tr>
                    <tr style="background-color: var(--absent-row-bg, rgba(239, 68, 68, 0.08));">
                        <td>محمود حسن</td>
                        <td>--</td>
                        <td><span style="color: var(--absent-color, #f87171); font-weight: bold;">لم يمتحن</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Popup 2: إضافة امتحان للمجموعة بالفلترة -->
<div class="custom-modal-overlay" id="addExamModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>اختيار امتحان لإضافته للمجموعة</h3>
            <button class="close-modal-btn" onclick="closeModal('addExamModal')">&times;</button>
        </div>

        <!-- فلترة الامتحانات -->
        <div class="filter-inputs-container">
            <input type="text" class="form-control-custom" placeholder="ابحث باسم الامتحان...">
           
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>اسم الامتحان</th>
                        <th>المادة</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>امتحان شامل - الجبر والهندسة</td>
                        <td>الرياضيات</td>
                        <td>
                            <button class="btn-main-action" style="padding: 4px 10px; font-size: 12px;">إضافة للمجموعة</button>
                        </td>
                    </tr>
                    <tr>
                        <td>اختبار السرعة - الفيزياء</td>
                        <td>الفيزياء</td>
                        <td>
                            <button class="btn-main-action" style="padding: 4px 10px; font-size: 12px;">إضافة للمجموعة</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Popup 3: رفع ملزمة/مذكرة -->
<div class="custom-modal-overlay" id="addMaterialModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>إضافة ملزمة أو مذكرة جديدة</h3>
            <button class="close-modal-btn" onclick="closeModal('addMaterialModal')">&times;</button>
        </div>
        <form style="display: flex; flex-direction: column; gap: 15px;">
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">عنوان الملزمة/المذكرة</label>
                <input type="text" class="form-control-custom" placeholder="أدخل العنوان...">
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">وصف قصير</label>
                <textarea class="form-control-custom" rows="3" placeholder="أدخل وصفاً لمحتوى الملزمة..."></textarea>
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">اختر الملف</label>
                <input type="file" class="form-control-custom">
            </div>
            <button type="button" class="btn-main-action" style="justify-content: center; margin-top: 10px;">رفع إلى المجموعة</button>
        </form>
    </div>
</div>


<!-- Popup 4: إضافة فيديو جديد -->
<div class="custom-modal-overlay" id="addVideoModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>إضافة فيديو جديد للمجموعة</h3>
            <button class="close-modal-btn" onclick="closeModal('addVideoModal')">&times;</button>
        </div>
        <form style="display: flex; flex-direction: column; gap: 15px;">
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">عنوان الفيديو</label>
                <input type="text" class="form-control-custom" placeholder="أدخل عنوان الفيديو...">
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">رابط الفيديو (YouTube مثلاً)</label>
                <input type="url" class="form-control-custom" placeholder="https://www.youtube.com/watch?v=...">
                <small style="color: var(--text-muted, #64748b); font-size: 12px; margin-top: 5px; display: block;">يرجى إدخال الرابط كاملاً.</small>
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">وصف قصير</label>
                <textarea class="form-control-custom" rows="3" placeholder="أدخل وصفاً لمحتوى الفيديو..."></textarea>
            </div>
            <button type="button" class="btn-main-action" style="justify-content: center; margin-top: 10px;">حفظ وإضافة الفيديو</button>
        </form>
    </div>
</div>

<script>
    // وظائف فتح وغلق الـ Popups
    function openModal(modalId) {
        document.getElementById(modalId).classList.add('active');
    }

    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('active');
    }

    // إغلاق النافذة المنبثقة عند الضغط على المساحة الخارجية
    window.onclick = function(event) {
        if (event.target.classList.contains('custom-modal-overlay')) {
            event.target.classList.remove('active');
        }
    }

    console.log("صفحة إدارة المجموعة جاهزة!");
</script>