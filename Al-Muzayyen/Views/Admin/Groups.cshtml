@model List<Available_slot>
@{
    Layout = "~/Views/Shared/_layoutadmin.cshtml";
    ViewData["Title"] = "Groups";
}
<link href="~/css/Filters.css" rel="stylesheet" />
<section id="groups-section">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 15px; margin-bottom: 20px; border: 1px solid #c3e6cb; border-radius: 4px; text-align: right; font-weight: bold;">
            <i class="fas fa-check-circle" style="margin-left: 5px;"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="groups-header">
        <div class="groups-header-top">

        <h2>إدارة المجموعات</h2>
        <button type="button" onclick="openCreateModal()" class="action-button" style="border:none; cursor:pointer;">
            إضافة مجموعة جديدة
        </button>
        </div>

        <form method="get" asp-action="Groups" class="groups-filter-form">
            <div class="filter-field">
                <label>الفلترة بالمكان:</label>
                <select name="placeId" onchange="this.form.submit()">
                    <option value="">كل الأماكن</option>
                    @foreach (var place in ViewBag.Places)
                    {
                        <!option value="@place.Id" @(ViewBag.SelectedPlace == place.Id ? "selected" : "")>@place.Name</!option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label>الفلترة بالصف:</label>
                <select name="classId" onchange="this.form.submit()">
                    <option value="">كل الصفوف</option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <!option value="@cls.Id" @(ViewBag.SelectedClass == cls.Id ? "selected" : "")>@cls.Name</!option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label>حالة المجموعات:</label>
                <select name="status" onchange="this.form.submit()">
                    @if (ViewBag.SelectedStatus == "Active")
                    {
                        <option value="Active" selected="selected">المجموعات النشطة فقط</option>
                    }
                    else
                    {
                        <option value="Active">المجموعات النشطة فقط</option>
                    }

                    @if (ViewBag.SelectedStatus == "Closed")
                    {
                        <option value="Closed" selected="selected">المجموعات المغلقة (المحذوفة)</option>
                    }
                    else
                    {
                        <option value="Closed">المجموعات المغلقة (المحذوفة)</option>
                    }

                    @if (ViewBag.SelectedStatus == "All")
                    {
                        <option value="All" selected="selected">عرض الكل</option>
                    }
                    else
                    {
                        <option value="All">عرض الكل</option>
                    }
                </select>
            </div>

            <div class="filter-field filter-reset">
                <label>&nbsp;</label>
                <a asp-action="Groups" class="reset-btn">إعادة تعيين</a>
            </div>
        </form>
    </div>

    <div class="table-responsive-container">
        <table class="data-display-table">
            <thead>
                <tr>
                    <th>اسم المجموعة</th>
                    <th>المكان</th>
                    <th>الصف</th>
                    <th>المواعيد</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var group in Model)
                {
                    
                    <tr data-id="@group.Id">
                        <td>@group.Group_Name</td>
                        <td>@group.Place?.Name</td>
                        <td>@group.Class?.Name</td>
                        <td>
                            @string.Join(", ", group.SlotTimes.Select(time => $"{time.Day} {time.Time.ToString("hh:mm tt")}"))
                        </td>
                        <td>
                            <button type="button" onclick="openEditModal(@group.Id)" class="action-icon-btn" style="color:blue; background:none; border:none; cursor:pointer;"><i class="fas fa-edit"></i></button>
                            <!-- زر إدارة المجموعة (تمت إضافته هنا) -->
                            <a asp-action="GroupManagement" Asp-controller="GroupManagement" asp-route-id="@group.Id" class="action-icon-btn" style="color:green; background:none; border:none; cursor:pointer; text-decoration: none;" title="إدارة المجموعة">
                                <i class="fas fa-users-cog"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@group.Id" method="post" onsubmit="return confirm('متأكد؟')" style="display:inline;">
                                <button type="submit" class="action-icon-btn" style="color:red; background:none; border:none; cursor:pointer;"><i class="fas fa-trash"></i></button>
                            </form>

                        </td>
                    </tr>

                     
                }
            </tbody>
        </table>
    </div>
</section>

<div id="group-modal" class="custom-popup-overlay">
    <div class="popup-window-content">
        <h3 id="modal-title">إضافة مجموعة جديدة</h3>

        <form id="group-form" onsubmit="saveGroup(event)">
            <input type="hidden" id="group-id">

            <div class="input-field-group">
                <label>اسم المجموعة</label>
                <input type="text" id="group-name" required>
            </div>

            <div class="input-field-group">
                <label>المكان</label>
                <select id="group-location" required>
                    @foreach (var place in ViewBag.Places)
                    {
                        <option value="@place.Id">@place.Name</option>
                    }
                </select>
            </div>

            <div class="input-field-group">
                <label>الصف</label>
                <select id="group-grade" required>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <option value="@cls.Id">@cls.Name</option>
                    }
                </select>
            </div>

            <div class="input-field-group">
                <label>عدد أيام الحضور</label>
                <select id="daysCount" onchange="generateDays()">
                    @for (int i = 1; i <= 7; i++)
                    {
                        <option value="@i">@i أيام</option>
                    }
                </select>
            </div>

            <div id="daysContainer"></div>

            <div class="popup-actions-flex">
                <button type="submit" class="action-button">إضافة</button>
                <button type="button" class="cancel-btn" onclick="closeModal()">إلغاء</button>
            </div>
        </form>
    </div>
</div>

<script>
    const daysArray = ["السبت", "الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"];

    // توليد حقول الأيام والمواعيد ديناميكياً
    function generateDays() {
        const count = parseInt(document.getElementById("daysCount").value) || 1;
        const container = document.getElementById("daysContainer");
        container.innerHTML = "";

        for (let i = 0; i < count; i++) {
            let options = daysArray.map(day => `<option value="${day}">${day}</option>`).join('');

            container.innerHTML += `
                <div class="day-card" style="border:1px solid #eee; padding:10px; margin-bottom:10px; border-radius:6px; background:#fafafa;">
                    <div class="day-title" style="font-weight:bold; margin-bottom:5px; color:#555;">اليوم ${i + 1}</div>
                    <div class="day-row" style="display:flex; gap:10px;">
                        <div class="day-field" style="flex:1;">
                            <label>اليوم</label>
                            <select class="slot-day" style="width:100%; padding:6px; border-radius:4px; border:1px solid #ccc;">${options}</select>
                        </div>
                        <div class="day-field" style="flex:1;">
                            <label>ميعاد الحصة</label>
                            <input type="time" class="slot-time" required style="width:100%; padding:5px; border-radius:4px; border:1px solid #ccc;">
                        </div>
                    </div>
                </div>
            `;
        }
    }

    function openCreateModal() {
        document.getElementById("group-id").value = "";
        document.getElementById("group-form").reset();
        document.getElementById("modal-title").innerText = "إضافة مجموعة جديدة";
        document.getElementById("daysCount").value = "1";
        generateDays();
        document.getElementById("group-modal").style.display = "flex";
    }

    async function openEditModal(id) {
        document.getElementById("group-form").reset();
        document.getElementById("modal-title").innerText = "تعديل مجموعة";
        
        // جلب البيانات الحقيقية من الداتا بيز بـ AJAX
        let response = await fetch(`/Admin/GetGroupById?id=${id}`);
        if (response.ok) {
            let group = await response.json();
            
            document.getElementById("group-id").value = group.id;
            document.getElementById("group-name").value = group.name;
            document.getElementById("group-location").value = group.placeId;
            document.getElementById("group-grade").value = group.classId;
            document.getElementById("daysCount").value = group.slots.length;
            
            generateDays();

            // ملء المواعيد الحقيقية في الـ Inputs
            const daySelects = document.querySelectorAll(".slot-day");
            const timeInputs = document.querySelectorAll(".slot-time");
            
            group.slots.forEach((slot, index) => {
                if(daySelects[index]) daySelects[index].value = slot.day;
                if(timeInputs[index]) timeInputs[index].value = slot.time;
            });

            document.getElementById("group-modal").style.display = "flex";
        } else {
            alert("فشل في جلب بيانات المجموعة.");
        }
    }

    function closeModal() {
        document.getElementById("group-modal").style.display = "none";
    }

    // حفظ البيانات عبر الـ AJAX (الإرسال للـ Controller بصيغة JSON)
  async function saveGroup(event) {
    event.preventDefault();

    const id = document.getElementById("group-id").value;
    const name = document.getElementById("group-name").value;
    const placeId = parseInt(document.getElementById("group-location").value);
    const classId = parseInt(document.getElementById("group-grade").value);
    const daysCount = parseInt(document.getElementById("daysCount").value);

    const daySelects = document.querySelectorAll(".slot-day");
    const timeInputs = document.querySelectorAll(".slot-time");
    
    let slotTimes = [];
    for (let i = 0; i < daysCount; i++) {
        slotTimes.push({
            Day: daySelects[i].value,
            Time: timeInputs[i].value
        });
    }

const payload = {
    id: id ? parseInt(id) : 0,
    group_Name: name,
    placeId: placeId,
    classId: classId,
    number_Of_day: daysCount,
    slotTimes: slotTimes // تأكد أن المبيعات داخل المصفوفة ترسل الحقول كـ { Day: "...", Time: "..." }
};

    const url = id ? '/Admin/EditAjax' : '/Admin/CreateAjax';

    let response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });

    if (response.ok) {
        let result = await response.json();
        if (result.success) {
            alert(result.message);
            location.reload(); 
        } else {
            alert(result.message);
        }
    } else {
        alert("حدث خطأ في السيرفر أثناء الحفظ.");
    }
}
</script>