@using Al_Muzayyen.Viewmodel
@model StudentDashboardViewModel

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "لوحة التحكم";
}




<style>
/* =========================================================
   7. تنسيقات لوحة تحكم الطالب (Student Dashboard Styling)
   ========================================================= */

.dashboard-content {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

/* بطاقة تعريف الطالب */
.student-profile-banner {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: var(--shadow-sm);
    flex-wrap: wrap;
    gap: 20px;
}

.student-info-main {
    display: flex;
    align-items: center;
    gap: 18px;
}

.student-avatar-badge {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--bg-alt-2);
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    border: 2px solid var(--primary-color);
    flex-shrink: 0;
}

.student-name {
    font-size: 1.4rem;
    color: var(--text-color);
    font-weight: 700;
    margin-bottom: 6px;
}

.student-meta-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.meta-tag {
    font-size: 0.85rem;
    color: var(--text-muted);
    background-color: var(--bg-alt);
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.academic-level-badge {
    padding: 12px 16px;
    border-radius: 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: var(--bg-alt);
    border: 1px solid var(--border-color);
}

.level-label {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.level-value {
    font-weight: 700;
    color: var(--primary-color);
    font-size: 1.05rem;
}

/* رؤوس الأقسام */
.section-header-block h2 {
    font-size: 1.15rem;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-header-block h2 i {
    color: var(--primary-color);
}

/* شبكة الإحصائيات */
.dashboard-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.metric-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.metric-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
}

.metric-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.bg-primary-light { background-color: rgba(197, 160, 89, 0.15); color: var(--primary-color); }
.bg-warning-light { background-color: rgba(239, 68, 68, 0.15); color: #ef4444; }
.bg-success-light { background-color: rgba(34, 197, 94, 0.15); color: #22c55e; }
.bg-info-light { background-color: rgba(59, 130, 246, 0.15); color: #3b82f6; }

.metric-info h3 {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
}

.metric-value {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-color);
    margin: 2px 0;
}

.metric-subtext {
    font-size: 0.75rem;
    color: var(--text-muted);
}

/* بطاقات التنبيهات */
.alerts-container {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.alert-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-right: 4px solid var(--primary-color);
    border-radius: 8px;
    padding: 16px 20px;
    display: flex;
    gap: 16px;
}

.alert-icon {
    font-size: 1.5rem;
    color: var(--primary-color);
    margin-top: 2px;
}

.alert-content {
    flex: 1;
}

.alert-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.alert-header h4 {
    font-size: 1rem;
    color: var(--text-color);
}

.alert-badge.new {
    background-color: var(--primary-color);
    color: var(--bg-dark);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
}

.alert-content p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 12px;
}

.alert-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 10px;
}

.btn-sm {
    padding: 6px 14px;
    font-size: 0.85rem;
}

/* الشبكة الثانوية والألواح Side Panels */
.dashboard-secondary-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.dashboard-panel {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    box-shadow: var(--shadow-sm);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-color);
}

.panel-header h3 {
    font-size: 1rem;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 8px;
}

.panel-link {
    font-size: 0.8rem;
    color: var(--primary-color);
    font-weight: 600;
}

.recent-items-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.recent-items-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--bg-alt);
}

.item-icon {
    font-size: 1.2rem;
    color: var(--primary-color);
}

.item-details {
    flex: 1;
}

.item-details h4 {
    font-size: 0.9rem;
    color: var(--text-color);
}

.item-details span {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.btn-icon {
    color: var(--text-muted);
    padding: 6px;
    transition: color 0.2s ease;
}

.btn-icon:hover {
    color: var(--primary-color);
}

.next-class-box {
    display: flex;
    align-items: center;
    gap: 15px;
    background-color: var(--bg-alt);
    padding: 16px;
    border-radius: 8px;
    border-right: 3px solid var(--primary-color);
}

.class-time-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--card-bg);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
}

.class-time-badge .day {
    font-weight: 700;
    color: var(--primary-color);
    font-size: 0.9rem;
}

.class-time-badge .time {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.class-info h4 {
    font-size: 0.95rem;
    color: var(--text-color);
}

.class-info p {
    font-size: 0.8rem;
    color: var(--text-muted);
}

/* =========================================================
   التجاوب مع الشاشات المتوسطة والصغيرة (Media Queries)
   ========================================================= */

@@media (max-width: 992px) {
    .dashboard-secondary-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 768px) {
    .student-profile-banner {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 20px;
    }

    .student-info-main {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 12px;
        width: 100%;
    }

    .student-meta-tags {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        gap: 8px;
    }

    .meta-tag {
        width: fit-content;
    }

    .academic-level-badge {
        width: 100%;
        align-items: center;
    }
}


    /* =========================================================
       تنسيقات كروت التنبيهات المتجاوبة (Responsive Alerts)
       ========================================================= */

    .alerts-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
    }

    /* الكارت الأساسي */
    .alert-card {
        background-color: var(--card-bg, #ffffff);
        border: 1px solid var(--border-color, #e5e7eb);
        border-right: 5px solid var(--primary-color, #c5a059); /* الشريط الذهبي الجانبي */
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: all 0.2s ease-in-out;
    }

    /* القسم الأيمن (البيانات والحديث) */
    .alert-main-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
        min-width: 0; /* لمنع الكلمات الطويلة من كسر التصميم */
    }

    /* العنوان مع البادج */
    .alert-title-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .alert-title-group h4 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-color, #1f2937);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .alert-title-group h4 i {
                color: var(--primary-color, #c5a059);
            }

    /* شارات الحالة (Badges) */
    .status-badge, .alert-badge {
        font-size: 0.75rem;
        padding: 3px 10px;
        border-radius: 6px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-success {
        background-color: rgba(34, 197, 94, 0.15);
        color: #15803d;
    }

    .badge-warning {
        background-color: rgba(234, 179, 8, 0.15);
        color: #a16207;
    }

    .badge-danger {
        background-color: rgba(239, 68, 68, 0.15);
        color: #b91c1c;
    }

    .alert-badge.new {
        background-color: var(--primary-color, #c5a059);
        color: #ffffff;
    }

    /* التفاصيل الداخلية (المجموعة/السبب/الوقت) */
    .alert-details-grid {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 0.88rem;
        color: var(--text-muted, #4b5563);
    }

        .alert-details-grid p {
            margin: 0;
        }

    .exam-desc {
        font-size: 0.88rem;
        color: var(--text-muted, #6b7280);
        margin: 0;
    }

    .exam-expiry {
        font-size: 0.82rem;
        color: #dc2626;
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
    }

    /* القسم الأيسر (الأزرار) */
    .alert-action-side {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    .btn-dismiss {
        background-color: var(--primary-color, #c5a059);
        color: #ffffff;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
        white-space: nowrap;
    }

        .btn-dismiss:hover {
            opacity: 0.9;
        }

    .btn-start-exam {
        background-color: var(--primary-color, #c5a059);
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

        .btn-start-exam:hover {
            opacity: 0.9;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .empty-alerts-box {
        text-align: center;
        padding: 30px;
        color: var(--text-muted, #9ca3af);
    }

        .empty-alerts-box i {
            font-size: 2rem;
            margin-bottom: 8px;
            display: block;
        }

    /* =========================================================
       التجاوب مع شاشات الموبايل (Media Queries)
       ========================================================= */

    @@media (max-width: 640px) {
        .alert-card {
            flex-direction: column; /* تحويل العناصر عمودياً في الموبايل */
            align-items: flex-start;
            gap: 14px;
            padding: 14px;
        }

        .alert-action-side {
            width: 100%; /* الزر يأخذ العرض كامل في الموبايل */
        }

        .btn-dismiss, .btn-start-exam {
            width: 100%;
            text-align: center;
        }

        .alert-details-grid {
            flex-direction: column;
            gap: 4px;
        }
    }

</style>
<div class="dashboard-content">

    <!-- 1. بطاقة التعريف بالطالب (تُحمل فوراً) -->
    <div class="student-profile-banner">
        <div class="student-info-main">
            <div class="student-avatar-badge">
                <i class="fa-solid fa-user-graduate"></i>
            </div>
            <div class="student-details">
                <h2 class="student-name">@Model.StudentName</h2>
                <div class="student-meta-tags">
                    <span class="meta-tag"><i class="fa-solid fa-layer-group"></i> @Model.ClassName</span>
                    <span class="meta-tag"><i class="fa-solid fa-users"></i> @Model.GroupName</span>
                </div>
            </div>
        </div>
      
    </div>

    <!-- 2. الإحصائيات الأكاديمية -->
    <div class="section-header-block mt-4">
        <h2><i class="fa-solid fa-chart-pie"></i> الإحصائيات الأكاديمية</h2>
    </div>

    <div class="dashboard-stats-grid" id="stats-container">
        <!-- مؤشر التحميل (Spinner) -->
        <div class="text-center w-100 py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل الإحصائيات...</p>
        </div>
    </div>

    <!-- 3. قسم التنبيهات والامتحانات الجديدة -->
    <div class="section-header-block mt-4">
        <h2><i class="fa-solid fa-bell"></i> التنبيهات والمهام القادمة</h2>
    </div>

    <div class="alerts-container" id="alerts-container">
        <!-- مؤشر التحميل (Spinner) -->
        <div class="text-center w-100 py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">جاري تحميل التنبيهات...</p>
        </div>
    </div>

</div>

<!-- Modal طلب تغيير المجموعة -->
<div class="modal fade" id="changeGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-right-left me-1"></i> طلب تغيير المجموعة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <form id="groupChangeForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">المجموعة المطلوبة <span class="text-danger">*</span></label>
                        <select class="form-select" name="requestedSlotId" required>
                            <option value="">اختر المجموعة...</option>
                            @foreach (var slot in Model.AvailableSlots)
                            {
                                <option value="@slot.Id">@slot.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">سبب التحويل</label>
                        <textarea class="form-control" name="reason" rows="3" placeholder="اكتب سبب طلب التحويل..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitGroup">إرسال الطلب</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // استدعاء الدوال فور فتح الصفحة
        fetchStudentStats();
        fetchStudentAlerts();

        // إرسال طلب تغيير المجموعة
        $("#groupChangeForm").on("submit", function(e) {
            e.preventDefault();
            var btn = $("#btnSubmitGroup");
            btn.prop("disabled", true).text("جاري الإرسال...");

            $.post('@Url.Action("SubmitGroupChangeRequest", "Student")', $(this).serialize(), function(res) {
                btn.prop("disabled", false).text("إرسال الطلب");
                if (res.success) {
                    alert(res.message);
                    $('#changeGroupModal').modal('hide');
                    $("#groupChangeForm")[0].reset();
                    fetchStudentAlerts();
                } else {
                    alert(res.message);
                }
            });
        });
    });

    // جلب الإحصائيات
    function fetchStudentStats() {
        $.get('@Url.Action("GetStudentStatsPartial", "Student")', function(html) {
            $('#stats-container').html(html);
        });
    }

    // جلب التنبيهات
    function fetchStudentAlerts() {
        $.get('@Url.Action("GetStudentAlertsPartial", "Student")', function(html) {
            $('#alerts-container').html(html);
        });
    }

    // إخفاء التنبيه
    function dismissNotification(requestId) {
        $.post('@Url.Action("DismissGroupNotification", "Student")', { requestId: requestId }, function(res) {
            if (res.success) {
                $('#req-alert-' + requestId).fadeOut(300, function() {
                    $(this).remove();
                });
            }
        });
    }
</script>