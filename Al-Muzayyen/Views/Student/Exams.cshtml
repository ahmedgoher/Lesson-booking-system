@model IEnumerable<Al_Muzayyen.ViewModels.StudentExamViewModel>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Exams";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="padding: 10px 15px; background: #f8d7da; color: #721c24; border-radius: 6px; margin-bottom: 15px;">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="padding: 10px 15px; background: #f8d7da; color: #721c24; border-radius: 6px; margin-bottom: 15px;">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert"
         class="alert alert-success"
         style="padding:10px 15px;
        background:#d1e7dd;
        color:#0f5132;
        border:1px solid #badbcc;
        border-radius:8px;
        margin-bottom:15px;">

        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

        <style>
            .disabled-exam{
    opacity:.35;
    cursor:not-allowed;
    pointer-events:none;
}

    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 85px;
        height: 32px;
        padding: 0 12px;
        border-radius: 20px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

.bg-success{
    background:#28a745;
}

.bg-secondary{
    background:#6c757d;
}

.bg-primary{
    background:#0d6efd;
}

.bg-danger{
    background:#dc3545;
}
    .status-cell {
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }
    .action-icon-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

@@media (max-width:768px){

    .badge{

        min-width:70px;
        height:28px;

        font-size:11px;

        padding:0 8px;
    }
    .data-display-table td.status-cell{
    padding:6px;
}

}
        </style>
<div class="exams-content">
    <div class="section-header-block">
        <h2>الامتحانات والاختبارات</h2>
    </div>

    <div class="table-responsive-container">
        <table class="data-display-table">
            <thead>
                <tr>
                    <th>اسم الامتحان</th>
                    <th>يبدأ في</th>
                    <th>ينتهي في</th>
                    <th>الحالة</th>
                    <th>الدرجة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var exam in Model)
                    {
                        <tr>

                            <td>@exam.ExamTitle</td>

                            <td>
                                @exam.StartTime.ToString("yyyy-MM-dd hh:mm tt")
                            </td>

                            <td>
                                @exam.EndTime.ToString("yyyy-MM-dd hh:mm tt")
                            </td>

                            <td class="status-cell">

                                @switch (exam.Status)
                                {
                                    case "NotStarted":
                                        <span class="badge bg-secondary">لم يبدأ</span>
                                        break;

                                    case "Available":
                                        <span class="badge bg-success">متاح</span>
                                        break;

                                    case "Completed":
                                        <span class="badge bg-primary">تم</span>
                                        break;

                                    case "Ended":
                                        <span class="badge bg-danger">انتهى</span>
                                        break;
                                }

                            </td>

                            <td>

                                @if (exam.IsCompleted)
                                {
                                    @($"{exam.Score} / {exam.TotalMarks}")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }

                            </td>

                            <td>

                                @if (exam.Status == "Completed")
                                {
                                    <a asp-controller="Exams"
                                       asp-action="Review"
                                       asp-route-examId="@exam.ExamId"
                                       class="action-icon-btn"
                                       title="مراجعة">

                                        <i class="fas fa-eye"></i>

                                    </a>
                                }
                                else if (exam.Status == "Available")
                                {
                                    <a asp-controller="Exams"
                                       asp-action="Start"
                                       asp-route-id="@exam.ExamId"
                                       class="action-icon-btn"
                                       title="بدء الامتحان"
                                       style="color:#28a745">

                                        <i class="fas fa-play"></i>

                                    </a>
                                }
                                else if (exam.Status == "NotStarted")
                                {
                                    <span class="action-icon-btn disabled-exam"
                                          title="الامتحان لم يبدأ">

                                        <i class="fas fa-play"></i>

                                    </span>
                                }
                                else
                                {
                                    <span class="action-icon-btn disabled-exam"
                                          title="انتهى الامتحان">

                                        <i class="fas fa-ban"></i>

                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted);">
                            لا توجد امتحانات متاحة لصفك الدراسي حالياً.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    setTimeout(function() {
        const alert = document.getElementById("successAlert");
        if (alert) {
            alert.style.transition = "0.5s";
            alert.style.opacity = "0";
            setTimeout(() => alert.remove(), 500);
        }
    }, 4000);
    console.log("صفحة الامتحانات جاهزة!");
</script>
