@model IEnumerable<Al_Muzayyen.ViewModels.StudentExamViewModel>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Exams";
}

<div class="exams-content">
    <div class="section-header-block">
        <h2>الامتحانات والاختبارات</h2>
    </div>

    <div class="table-responsive-container">
        <table class="data-display-table">
            <thead>
                <tr>
                    <th>اسم الامتحان</th>
                    <th>التاريخ</th>
                    <th>الدرجة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td>@exam.ExamTitle</td>
                            <td>@exam.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (exam.IsCompleted)
                                {
                                    <span>@exam.Score / @exam.TotalMarks</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted, #777);">لم يتم</span>
                                }
                            </td>
                            <td>
                                @if (exam.IsCompleted)
                                {
                                    <!-- 👁️ تم الامتحان: الانتقال لصفحة مراجعة الاجابات والنتيجة -->
                                    <a asp-controller="Student"
                                       asp-action="ReviewExam"
                                       asp-route-id="@exam.ExamId"
                                       class="action-icon-btn"
                                       title="مراجعة الامتحان">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                }
                                else
                                {
                                    <!-- ▶️ لم يتم: الانتقال لصفحة خوض الامتحان -->
                                    <a asp-controller="Student"
                                       asp-action="TakeExam"
                                       asp-route-id="@exam.ExamId"
                                       class="action-icon-btn"
                                       title="بدء الامتحان"
                                       style="color: var(--success-color, #28a745);">
                                        <i class="fas fa-play"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted);">
                            لا توجد امتحانات متاحة لصفك الدراسي حالياً.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    console.log("صفحة الامتحانات جاهزة!");
</script>