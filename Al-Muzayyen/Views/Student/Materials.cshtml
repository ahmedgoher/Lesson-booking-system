@using Al_Muzayyen.Viewmodel
@model StudentMatrialVM
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Materials";
}
@section Styles{
    <style>
        .video-card{
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
    </style>
}


<div class="materials-content">
    <div class="section-header-block">
        <h2>@Model.GroupName الملازم والمذكرات</h2>
    </div> 

    <div class="materials-grid videos-grid">
        @foreach(var mat in Model.Matrials)
        {
            <div class="video-card">
                <h3>@mat.Title</h3>
                <p>@mat.Description</p>
                <a href="@mat.Url" target="_blank" class="action-icon-btn" title="تحميل / فتح">
                    <i class="fas fa-download"></i>
                </a>
            </div>
            
        }
    </div>
</div>

