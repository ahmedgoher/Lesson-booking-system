@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Materials";
}



<div class="materials-content">
    <div class="section-header-block">
        <h2>الملازم والمذكرات</h2>
    </div> 

    <div class="materials-grid videos-grid">
        <div class="video-card">
            <h3>ملزمة الرياضيات - الفصل الأول</h3>
            <p>ملخص شامل لمادة الرياضيات للفصل الدراسي الأول.</p>
            <button class="edit-video-btn">تحميل الملزمة</button>
        </div>
        <div class="video-card">
            <h3>مذكرات الفيزياء - الوحدة الثانية</h3>
            <p>ملاحظات ومسائل محلولة لوحدة الفيزياء الثانية.</p>
            <button class="edit-video-btn">تحميل المذكرة</button>
        </div>
        <div class="video-card">
            <h3>كتاب الكيمياء العضوية</h3>
            <p>الكتاب المقرر لمادة الكيمياء العضوية.</p>
            <button class="edit-video-btn">تحميل الكتاب</button>
        </div>
    </div>
</div>

