@model Al_Muzayyen.ViewModels.StudentProfileVM

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "الملف الشخصي";
}

<style>
    /* =========================================================
           8. تنسيقات صفحة الملف الشخصي (Student Profile Styling)
           ========================================================= */

    .profile-container {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    /* كارت هيدر الملف الشخصي */
    .profile-header-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: var(--shadow-sm);
        flex-wrap: wrap;
    }

    .profile-main-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .avatar-upload-wrapper {
        position: relative;
        width: 85px;
        height: 85px;
        flex-shrink: 0;
        margin: 0 auto;
    }

    .avatar-preview {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-color: var(--bg-alt-2);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        border: 3px solid var(--primary-color);
    }

    .avatar-edit-btn {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 30px;
        height: 30px;
        background-color: var(--primary-color);
        color: var(--bg-dark);
        border: 2px solid var(--card-bg);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.8rem;
        transition: transform 0.2s ease;
    }

        .avatar-edit-btn:hover {
            transform: scale(1.1);
        }

    .profile-header-info .student-name {
        font-size: 1.4rem;
        color: var(--text-color);
        font-weight: 700;
    }

    .profile-header-info .student-email {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 10px;
    }

    .student-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .profile-badge {
        font-size: 0.8rem;
        background-color: var(--bg-alt);
        color: var(--primary-color);
        border: 1px solid var(--border-color);
        padding: 4px 12px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-change-group {
        background-color: var(--bg-alt-2);
        color: var(--primary-color);
        border: 1px solid var(--primary-color);
        white-space: nowrap;
    }

        .btn-change-group:hover {
            background-color: var(--primary-color);
            color: var(--bg-dark);
        }

    /* شبكة النماذج */
    .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 25px;
    }

    .profile-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
    }

    .card-header-title {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 15px;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--border-color);
        color: var(--primary-color);
    }

        .card-header-title h3 {
            font-size: 1.1rem;
            color: var(--text-color);
        }

    .profile-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
        flex: 1;
    }

    /* تنسيق الحقول والإيقونات */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-color);
        }

    .input-icon-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        right: 14px;
        color: var(--text-muted);
        font-size: 0.95rem;
        pointer-events: none;
    }

    .custom-input {
        width: 100%;
        padding: 11px 40px 11px 14px;
        background-color: var(--bg-alt);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-color);
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .custom-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px var(--primary-glow);
        }

    .form-actions {
        margin-top: auto;
        padding-top: 10px;
    }

        .form-actions .action-button {
            width: 100%;
        }

    /* =========================================================
           9. تنسيق النوافذ المنبثقة (Popup Modal)
           ========================================================= */

    .custom-popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .popup-window-content {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        width: 90%;
        max-width: 500px;
        padding: 24px;
        box-shadow: var(--shadow-md);
    }

    .popup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
    }

        .popup-header h3 {
            margin-bottom: 0 !important;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1.1rem;
            color: var(--text-color);
        }

    .close-popup-btn {
        background: none;
        border: none;
        font-size: 1.6rem;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .close-popup-btn:hover {
            color: var(--primary-color);
        }

    .popup-description {
        font-size: 0.88rem;
        color: var(--text-muted);
        margin-bottom: 15px;
    }

    .custom-select {
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
    }

    .custom-textarea {
        resize: vertical;
        padding-right: 14px !important;
    }

    .popup-actions-flex {
        display: flex;
        gap: 12px;
        margin-top: 10px;
    }

        .popup-actions-flex .action-button {
            flex: 1;
        }

    /* التجاوب */
    @@media (max-width: 768px) {
        .profile-header-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .header-action-side {
            width: 100%;
        }

        .btn-change-group {
            width: 100%;
        }

        .profile-main-info {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 576px) {
        .student-badges {
            justify-content: center;
        }
    }
</style>

@Html.AntiForgeryToken()

<div class="profile-container">

    <!-- كارت هيدر البروفايل والصورة الشخصية -->
    <div class="profile-header-card">
        <div class="profile-main-info">
            <div class="avatar-upload-wrapper">
                <div class="avatar-preview">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
            </div>
            <div class="profile-header-info">
                <h2 class="student-name" id="displayStudentName">@Model.Name</h2>
                <div class="student-badges">
                    <span class="profile-badge"><i class="fa-solid fa-layer-group"></i> @Model.ClassName</span>
                    <span class="profile-badge"><i class="fa-solid fa-users"></i> @Model.GroupName</span>
                </div>
            </div>
        </div>

        <!-- زر طلب تغيير المجموعة -->
        <div class="header-action-side">
            <button type="button" class="action-button btn-change-group" id="openGroupModalBtn">
                <i class="fa-solid fa-arrows-rotate"></i> طلب تغيير المجموعة
            </button>
        </div>
    </div>

    <!-- شبكة النماذج وإعدادات الحساب -->
    <div class="profile-grid">

        <!-- القسم الأول: البيانات الشخصية -->
        <div class="profile-card">
            <div class="card-header-title">
                <i class="fa-solid fa-user-gear"></i>
                <h3>البيانات الشخصية</h3>
            </div>

            <form id="infoForm" class="profile-form">
                <div class="form-group">
                    <label for="userName">اسم الطالب بالكامل</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input type="text" id="userName" class="custom-input" asp-for="Name" required placeholder="أدخل اسمك بالكامل">
                    </div>
                </div>

                <div class="form-group">
                    <label for="userPhone">رقم الهاتف</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-phone input-icon"></i>
                        <input type="tel" id="userPhone" class="custom-input" asp-for="StdPhone" required placeholder="أدخل رقم الهاتف">
                    </div>
                </div>

                <div class="form-group">
                    <label for="parentPhone">رقم هاتف ولي الأمر</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-mobile-screen-button input-icon"></i>
                        <input type="tel" id="parentPhone" class="custom-input" asp-for="ParentPhone" required placeholder="أدخل رقم ولي الأمر">
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="action-button">
                        <i class="fa-solid fa-floppy-disk"></i> حفظ البيانات الشخصية
                    </button>
                </div>
            </form>
        </div>

        <!-- القسم الثاني: الأمان وتغيير كلمة المرور -->
        <div class="profile-card">
            <div class="card-header-title">
                <i class="fa-solid fa-shield-halved"></i>
                <h3>الأمان وكلمة المرور</h3>
            </div>

            <form id="passwordForm" class="profile-form">
                <div class="form-group">
                    <label for="currentPassword">كلمة المرور الحالية</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input type="password" id="currentPassword" class="custom-input" required placeholder="••••••••">
                    </div>
                </div>

                <div class="form-group">
                    <label for="userPassword">كلمة المرور الجديدة</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-key input-icon"></i>
                        <input type="password" id="userPassword" class="custom-input" required placeholder="أدخل كلمة مرور قوية">
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">تأكيد كلمة المرور الجديدة</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-check-double input-icon"></i>
                        <input type="password" id="confirmPassword" class="custom-input" required placeholder="أعد كتابة كلمة المرور">
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="action-button btn-secondary">
                        <i class="fa-solid fa-key"></i> تحديث كلمة المرور
                    </button>
                </div>
            </form>
        </div>

    </div>

</div>

<!-- Popup (Modal) طلب تغيير المجموعة كما طلبتها بالضبط -->
<div class="custom-popup-overlay" id="changeGroupModal">
    <div class="popup-window-content">
        <div class="popup-header">
            <h3><i class="fa-solid fa-arrows-rotate"></i> طلب تغيير المجموعة</h3>
            <button type="button" class="close-popup-btn" id="closeGroupModalBtn">&times;</button>
        </div>

        <form id="changeGroupForm" class="profile-form">
            <p class="popup-description">يرجى اختيار المكان والصف والمجموعة الجديدة للتحويل إليها:</p>

            <!-- اختيار المكان / السنتر -->
            <div class="form-group">
                <label for="centerLocation">المكان / الفرع</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-location-dot input-icon"></i>
                    <select id="centerLocation" class="custom-input custom-select" required>
                        <option value="" disabled selected>اختر المكان / السنتر</option>
                        <option value="1">سنتر النور - المقر الرئيسي</option>
                        <option value="2">سنتر التفوق - فرع المهندسين</option>
                        <option value="3">أونلاين (عن بُعد)</option>
                    </select>
                </div>
            </div>

            <!-- اختيار الصف الدراسي -->
            <div class="form-group">
                <label for="gradeLevel">الصف الدراسي</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-layer-group input-icon"></i>
                    <select id="gradeLevel" class="custom-input custom-select" required>
                        <option value="" disabled selected>اختر الصف الدراسي</option>
                        <option value="1">الصف الأول الثانوي</option>
                        <option value="2">الصف الثاني الثانوي</option>
                        <option value="3">الصف الثالث الثانوي</option>
                    </select>
                </div>
            </div>

            <!-- اختيار المجموعة الجديدة -->
            <div class="form-group">
                <label for="newGroup">المجموعة الجديدة</label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-users input-icon"></i>
                    <select id="newGroup" class="custom-input custom-select" required>
                        <option value="" disabled selected>اختر المجموعة المتاحة</option>
                        <option value="A">مجموعة A (السبت والأربعاء - 04:00 مساءً)</option>
                        <option value="B">مجموعة B (الأحد والثلاثاء - 06:00 مساءً)</option>
                        <option value="C">مجموعة C (الإثنين والخميس - 02:00 ظهراً)</option>
                    </select>
                </div>
            </div>

            <!-- ملاحظات إضافية (اختياري) -->
            <div class="form-group">
                <label for="requestNotes">سبب التحويل / ملاحظات</label>
                <textarea id="requestNotes" class="custom-input custom-textarea" rows="3" placeholder="أكتب أي ملاحظات قد تفيد الإدارة..."></textarea>
            </div>

            <div class="popup-actions-flex">
                <button type="button" class="action-button btn-secondary" id="cancelGroupModalBtn">إلغاء</button>
                <button type="submit" class="action-button">إرسال الطلب</button>
            </div>
        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('changeGroupModal');
    const openBtn = document.getElementById('openGroupModalBtn');
    const closeBtn = document.getElementById('closeGroupModalBtn');
    const cancelBtn = document.getElementById('cancelGroupModalBtn');

    // فتح الـ Popup
    openBtn.addEventListener('click', () => {
    modal.style.display = 'flex';
    });

    // إغلاق الـ Popup
    const closeModal = () => {
    modal.style.display = 'none';
    };

    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);

    // إغلاق النافذة عند الضغط خارجها
    window.addEventListener('click', (e) => {
    if (e.target === modal) {
    closeModal();
    }
    });
    });

    // --------------------------------------------------
    // معالجة النماذج الأخرى باستخدام AJAX
    // --------------------------------------------------
    const token = $('input[name="__RequestVerificationToken"]').val();

    // حفظ البيانات الشخصية
    $('#infoForm').submit(function (e) {
    e.preventDefault();

    var data = {
    Name: $('#userName').val(),
    StdPhone: $('#userPhone').val(),
    ParentPhone: $('#parentPhone').val()
    };

    $.ajax({
    url: '/Student/UpdateInfo',
    type: 'POST',
    contentType: 'application/json',
    headers: { "RequestVerificationToken": token },
    data: JSON.stringify(data),
    success: function (res) {
    if (res.success) {
    alert(res.message);
    $('#displayStudentName').text(data.Name);
    } else {
    alert(res.message);
    }
    },
    error: function () {
    alert("حدث خطأ أثناء حفظ البيانات!");
    }
    });
    });

    // تحديث كلمة المرور
    $('#passwordForm').submit(function (e) {
    e.preventDefault();

    var currentPass = $('#currentPassword').val();
    var newPass = $('#userPassword').val();
    var confirmPass = $('#confirmPassword').val();

    if (newPass !== confirmPass) {
    alert("كلمة المرور الجديدة غير متطابقة مع التأكيد!");
    return;
    }

    var data = {
    CurrentPassword: currentPass,
    NewPassword: newPass,
    ConfirmPassword: confirmPass
    };

    $.ajax({
    url: '/Student/UpdatePassword',
    type: 'POST',
    contentType: 'application/json',
    headers: { "RequestVerificationToken": token },
    data: JSON.stringify(data),
    success: function (res) {
    if (res.success) {
    alert(res.message);
    $('#passwordForm')[0].reset();
    } else {
    alert(res.message);
    }
    },
    error: function () {
    alert("حدث خطأ أثناء تحديث كلمة المرور!");
    }
    });
    });
</script>