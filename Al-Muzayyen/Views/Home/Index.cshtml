@{
    Layout = "~/Views/Shared/_layouthome.cshtml"; 
    ViewData["Title"] = "Home Page";
}

<section class="hero">
    <div class="container">
        <div>
            <h2>فارس اللغة العربية</h2>
            <p>نحن نبني جيلاً يعتز بلغته ويتقن أسرارها. رحلة التميز في اللغة العربية تبدأ من هنا مع الأستاذ عبد الفتاح المزين.</p>
            <div class="hero-btns">
                <a href="/Booking/booking" class="btn btn-primary">ابدأ رحلتك الآن</a>
            </div>
        </div>

        <div>
            <img src="~/images/image.png" alt="فارس اللغة العربية">
        </div>

    </div>
</section>

<section id="about" class="features">
    <div class="container">
        <div class="section-title">
            <h2>عن الأستاذ عبد الفتاح المزين</h2>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <i class="fas fa-user-tie"></i>
                <h3>خبرة واسعة</h3>
                <p>سنوات من الخبرة في تدريس اللغة العربية للمرحلة الثانوية بأسلوب مبسط ومبتكر.</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-book-open"></i>
                <h3>منهجية متطورة</h3>
                <p>نعتمد على أحدث الوسائل التعليمية لضمان وصول المعلومة وتثبيتها في ذهن الطالب.</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-tasks"></i>
                <h3>متابعة دورية</h3>
                <p>اختبارات أسبوعية وتقارير شهرية لولي الأمر لمتابعة مستوى الطالب خطوة بخطوة.</p>
            </div>
        </div>
    </div>
</section>

<!-- Videos Section -->
<section class="videos">
    <div class="container">

        <div class="section-title">
            <h2>فيديوهات الأستاذ</h2>
            <p>تعرف على الأستاذ عبد الفتاح المزين من خلال مجموعة من الفيديوهات المميزة.</p>
        </div>

        <div class="videos-grid">

            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/i59pw-1VHFc?si=XSdqs0Kssxsap8fE"
                        title="رسالة للطلاب"
                        allowfullscreen>
                </iframe>

                <h3>رسالة إلى الطلاب</h3>
                <p>كلمة تحفيزية من الأستاذ لجميع الطلاب في بداية العام الدراسي.</p>
            </div>

            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/i59pw-1VHFc?si=XSdqs0Kssxsap8fE"
                        title="شرح مميز"
                        allowfullscreen>
                </iframe>

                <h3>شرح مميز</h3>
                <p>جزء من أحد الدروس لعرض أسلوب الشرح.</p>
            </div>

            <div class="video-card">
                <iframe src="https://www.youtube.com/embed/i59pw-1VHFc?si=XSdqs0Kssxsap8fE"
                        title="نصائح للمذاكرة"
                        allowfullscreen>
                </iframe>

                <h3>نصائح للمذاكرة</h3>
                <p>أفضل النصائح لتحقيق أعلى الدرجات في اللغة العربية.</p>
            </div>

        </div>

    </div>
</section>




<section class="features">
    <div class="container">

        <div class="section-title">
            <h2>المراحل الدراسية</h2>
        </div>

        <div id="grades-list" class="features-grid">

            <div class="feature-card">
                <i class="fas fa-book-open"></i>
                <h3>الصف الأول الإعدادي</h3>
                <p>شرح شامل وتدريبات مستمرة وفق أحدث نظام امتحانات.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-book-open"></i>
                <h3>الصف الثاني الإعدادي</h3>
                <p>مراجعات دورية واختبارات لقياس مستوى الطلاب.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-book-open"></i>
                <h3>الصف الثالث الإعدادي</h3>
                <p>تأسيس قوي واستعداد كامل لامتحانات الشهادة الإعدادية.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-graduation-cap"></i>
                <h3>الصف الأول الثانوي</h3>
                <p>شرح مبسط للمنهج مع تدريبات متنوعة.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-graduation-cap"></i>
                <h3>الصف الثاني الثانوي</h3>
                <p>تدريب على أسئلة التفكير والفهم ونظام الامتحانات.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-graduation-cap"></i>
                <h3>الصف الثالث الثانوي</h3>
                <p>مراجعات نهائية واختبارات تحاكي الامتحان الفعلي.</p>
            </div>

        </div>

    </div>
</section>



<section class="features">
    <div class="container">

        <div class="section-title">
            <h2>أماكن السناتر</h2>
        </div>

        <div id="locations-list" class="features-grid">

            <div class="feature-card">
                <i class="fas fa-map-marker-alt"></i>
                <h3>سنتر المدينة</h3>
                <p>شارع الجمهورية - بجوار محطة القطار.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-map-marker-alt"></i>
                <h3>سنتر النور</h3>
                <p>شارع الجيش - أمام نادي المدينة.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-map-marker-alt"></i>
                <h3>سنتر الأوائل</h3>
                <p>شارع التحرير - بجوار المدرسة الثانوية.</p>
            </div>

        </div>

    </div>
</section>
