@using Al_Muzayyen.Viewmodel
@model HomeVM

@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "Home Page";
}

<section class="hero">
    <div class="container">
        <div>
            <h2>فارس اللغة العربية</h2>
            <p>
                نحن نبني جيلاً يعتز بلغته ويتقن أسرارها. رحلة التميز في اللغة العربية تبدأ من هنا
                مع الأستاذ عبد الفتاح المزين.
            </p>

            <div class="hero-btns">
                <a href="/Booking/booking" class="btn btn-primary">
                    ابدأ رحلتك الآن
                </a>
            </div>
        </div>

        <div>
            <img src="@(Model?.linkimage ?? "/images/imgde.jfif")" alt="فارس اللغة العربية">
        </div>
    </div>
</section>

<section id="about" class="features">
    <div class="container">
        <div class="section-title">
            <h2>عن الأستاذ عبد الفتاح المزين</h2>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <i class="fas fa-user-tie"></i>
                <h3>خبرة واسعة</h3>
                <p>سنوات من الخبرة في تدريس اللغة العربية للمرحلة الثانوية بأسلوب مبسط ومبتكر.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-book-open"></i>
                <h3>منهجية متطورة</h3>
                <p>نعتمد على أحدث الوسائل التعليمية لضمان وصول المعلومة وتثبيتها في ذهن الطالب.</p>
            </div>

            <div class="feature-card">
                <i class="fas fa-tasks"></i>
                <h3>متابعة دورية</h3>
                <p>اختبارات أسبوعية وتقارير شهرية لولي الأمر لمتابعة مستوى الطالب خطوة بخطوة.</p>
            </div>
        </div>
    </div>
</section>

<!-- Videos Section -->
<section id="videos" class="videos">
    <div class="container">

        <div class="section-title">
            <h2>فيديوهات الأستاذ</h2>
            <p>تعرف على الأستاذ عبد الفتاح المزين من خلال مجموعة من الفيديوهات المميزة.</p>
        </div>

        <div class="videos-grid">

            @if (Model?.LinkesVideos?.Any() == true)
            {
                @foreach (var video in Model.LinkesVideos)
                {
                    <div class="video-card">
                        <iframe src="@(video?.URL ?? "")"
                                title="@(video?.Title ?? "Video")"
                                allowfullscreen>
                        </iframe>

                        <h3>@(video?.Title ?? "بدون عنوان")</h3>
                        <p>@(video?.Description ?? "لا يوجد وصف")</p>
                    </div>
                }
            }
            else
            {
                <p style="width:100%;text-align:center;">لا توجد فيديوهات حالياً.</p>
            }

        </div>

    </div>
</section>

<section class="features">
    <div class="container">

        <div class="section-title">
            <h2>المراحل الدراسية</h2>
        </div>

        <div id="grades-list" class="features-grid">

            @if (Model?.classes?.Any() == true)
            {
                @foreach (var grade in Model.classes)
                {
                    <div class="feature-card">
                        <i class="fas fa-book-open"></i>
                        <h3>@(grade?.Name ?? "غير محدد")</h3>
                    </div>
                }
            }
            else
            {
                <p style="width:100%;text-align:center;">لا توجد مراحل دراسية.</p>
            }

        </div>

    </div>
</section>

<section class="features">
    <div class="container">

        <div class="section-title">
            <h2>أماكن السناتر</h2>
        </div>

        <div id="locations-list" class="features-grid">

            @if (Model?.places?.Any() == true)
            {
                @foreach (var place in Model.places)
                {
                    <div class="feature-card">
                        <i class="fas fa-map-marker-alt"></i>
                        <h3>@(place?.Name ?? "غير محدد")</h3>
                        <p>@(place?.Address ?? "لا يوجد عنوان")</p>
                    </div>
                }
            }
            else
            {
                <p style="width:100%;text-align:center;">لا توجد أماكن سناتر.</p>
            }

        </div>

    </div>
</section>