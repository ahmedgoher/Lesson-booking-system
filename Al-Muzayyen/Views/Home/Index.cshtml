@using Al_Muzayyen.Viewmodel

@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero animate-on-scroll fade-in">
    <div class="hero-particles" id="hero-particles"></div>
    <div class="container">
        <div class="hero-text">
            <h2>فارس اللغة العربية</h2>
            <p>
                نحن نبني جيلاً يعتز بلغته ويتقن أسرارها. رحلة التميز في اللغة العربية تبدأ من هنا مع الأستاذ عبد الفتاح المزين.
            </p>
           
            @if (User.IsInRole("Student"))
            {
                <div class="hero-btns">
                    <a href="/Student" class="btn btn-primary">ابدأ رحلتك الآن</a>
                </div>
            }
            else
            {
                <div class="hero-btns">
                    <a href="/Booking/booking" class="btn btn-primary">ابدأ رحلتك الآن</a>
                </div>
            }
        </div>

        <div class="hero-img-wrapper">
            <img id="hero-image" src="/images/image.png" alt="فارس اللغة العربية" class="floating-img">
        </div>
    </div>
</section>

<!-- Section: عن الأستاذ -->
<section id="about" class="features animate-on-scroll slide-up">
    <div class="container">
        <div class="section-title">
            <h2>عن الأستاذ عبد الفتاح المزين</h2>
        </div>
        <div class="features-grid">
            <div class="feature-card zoom-effect">
                <i class="fas fa-user-tie"></i>
                <h3>خبرة واسعة</h3>
                <p>سنوات من الخبرة في تدريس اللغة العربية للمرحلة الثانوية بأسلوب مبسط ومبتكر.</p>
            </div>
            <div class="feature-card zoom-effect">
                <i class="fas fa-book-open"></i>
                <h3>منهجية متطورة</h3>
                <p>نعتمد على أحدث الوسائل التعليمية لضمان وصول المعلومة وتثبيتها في ذهن الطالب.</p>
            </div>
            <div class="feature-card zoom-effect">
                <i class="fas fa-tasks"></i>
                <h3>متابعة دورية</h3>
                <p>اختبارات أسبوعية وتقارير شهرية لولي الأمر لمتابعة مستوى الطالب خطوة بخطوة.</p>
            </div>
        </div>
    </div>
</section>

<!-- Videos Section -->
<section id="videos" class="videos animate-on-scroll flip-in">
    <div class="container">
        <div class="section-title">
            <h2>فيديوهات الأستاذ</h2>
            <p>تعرف على الأستاذ عبد الفتاح المزين من خلال مجموعة من الفيديوهات المميزة.</p>
        </div>
        <div class="videos-grid" id="videos-grid-container">
            <!-- Loading State -->
            <p style="width:100%;text-align:center;color:var(--gray);">جاري تحميل الفيديوهات...</p>
        </div>
    </div>
</section>

<!-- المراحل الدراسية -->
<section class="features animate-on-scroll slide-right">
    <div class="container">
        <div class="section-title">
            <h2>المراحل الدراسية</h2>
        </div>
        <div id="grades-list" class="features-grid">
            <!-- Loading State -->
            <p style="width:100%;text-align:center;color:var(--gray);">جاري تحميل المراحل الدراسية...</p>
        </div>
    </div>
</section>

<!-- أماكن السناتر -->
<section class="features animate-on-scroll slide-left">
    <div class="container">
        <div class="section-title">
            <h2>أماكن السناتر</h2>
        </div>
        <div id="locations-list" class="features-grid">
            <!-- Loading State -->
            <p style="width:100%;text-align:center;color:var(--gray);">جاري تحميل الفروع...</p>
        </div>
    </div>
</section>

<!-- آراء أبطال الفارس -->
<section id="testimonials" class="testimonials-section animate-on-scroll scale-up">
    <div class="container">
        <div class="section-title">
            <h2>آراء أبطال الفارس</h2>
            <p>ماذا يقول طلابنا وأولياء الأمور عنا؟</p>
        </div>
        <div class="testimonials-grid">
            <div class="testimonial-card">
                <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <p>"بفضل الله ثم شرح الأستاذ عبد الفتاح قدرت أقفل مادة اللغة العربية في الثانوية العامة. أسلوبه مميز جداً."</p>
                <h4>أحمد محمود</h4>
                <span>طالب ثانوية عامة</span>
            </div>
            <div class="testimonial-card">
                <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <p>"المتابعة الدورية والاختبارات الأسبوعية كانت بتخليني عارف مستوى ابني أول بأول. شكراً لحضرتك."</p>
                <h4>م. محمد علي</h4>
                <span>ولي أمر</span>
            </div>
            <div class="testimonial-card">
                <div class="stars">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <p>"النحو كان بالنسبة لي عقدة، مع الأستاذ عبد الفتاح بقى أسهل فرع في المادة!"</p>
                <h4>مريم حسن</h4>
                <span>طالبة بالصف الثاني الثانوي</span>
            </div>
        </div>
    </div>
</section>

<!-- الأسئلة الشائعة -->
<section id="faq" class="faq-section animate-on-scroll slide-up">
    <div class="container">
        <div class="section-title">
            <h2>الأسئلة الشائعة</h2>
        </div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>كيف يمكنني حجز مقعد مع الأستاذ؟</summary>
                <p>يمكنك التوجه لصفحة "حجز موعد" وتعبئة البيانات، أو زيارة أقرب سنتر لك لمزيد من التفاصيل.</p>
            </details>
            <details class="faq-item">
                <summary>هل توجد حصص مراجعة أونلاين؟</summary>
                <p>نعم، بنوفر فيديوهات مراجعة واختبارات تفاعلية مستمرة لجميع الطلاب المسجلين.</p>
            </details>
            <details class="faq-item">
                <summary>كيف يتم متابعة مستوى الطالب؟</summary>
                <p>يتم إجراء امتحانات أسبوعية وإرسال التقييمات عبر تقارير شهرية لولاة الأمور.</p>
            </details>
        </div>
    </div>
</section>

<!-- JavaScript لجلب البيانات بشكل مستقل وموازٍ -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetchHeroImage();
        fetchClasses();
        fetchPlaces();
        fetchVideos();
    });

    // 1. جلب صورة Hero
    function fetchHeroImage() {
        fetch('/Home/GetHeroImage')
            .then(res => res.json())
            .then(data => {
                if (data.linkimage) {
                    document.getElementById('hero-image').src = data.linkimage;
                }
            })
            .catch(err => console.error("Error loading hero image:", err));
    }

    // 2. جلب المراحل الدراسية
    function fetchClasses() {
        const container = document.getElementById('grades-list');
        
        fetch('/Home/GetClasses')
            .then(res => res.json())
            .then(classes => {
                container.innerHTML = '';

                if (!classes || classes.length === 0) {
                    container.innerHTML = `<p style="width:100%;text-align:center;color:var(--gray);">لا توجد مراحل دراسية.</p>`;
                    return;
                }

                classes.forEach(grade => {
                    container.innerHTML += `
                        <div class="feature-card">
                            <i class="fas fa-graduation-cap"></i>
                            <h3>${grade.name || 'غير محدد'}</h3>
                            <p>شرح شامل وتدريبات مستمرة وفق أحدث نظام امتحانات.</p>
                        </div>
                    `;
                });
            })
            .catch(err => {
                console.error("Error loading classes:", err);
                container.innerHTML = `<p style="width:100%;text-align:center;color:var(--gray);">حدث خطأ أثناء تحميل المراحل.</p>`;
            });
    }

    // 3. جلب السناتر
    function fetchPlaces() {
        const container = document.getElementById('locations-list');

        fetch('/Home/GetPlaces')
            .then(res => res.json())
            .then(places => {
                container.innerHTML = '';

                if (!places || places.length === 0) {
                    container.innerHTML = `<p style="width:100%;text-align:center;color:var(--gray);">لا توجد أماكن سناتر.</p>`;
                    return;
                }

                places.forEach(place => {
                    container.innerHTML += `
                        <div class="feature-card pulse-card">
                            <i class="fas fa-map-marker-alt"></i>
                            <h3>${place.name || 'غير محدد'}</h3>
                            <p>${place.address || 'لا يوجد عنوان'}</p>
                        </div>
                    `;
                });
            })
            .catch(err => {
                console.error("Error loading places:", err);
                container.innerHTML = `<p style="width:100%;text-align:center;color:var(--gray);">حدث خطأ أثناء تحميل الفروع.</p>`;
            });
    }

    // 4. جلب الفيديوهات
    function fetchVideos() {
        const container = document.getElementById('videos-grid-container');

        fetch('/Home/GetVideos')
            .then(res => res.json())
            .then(videos => {
                container.innerHTML = '';

                if (!videos || videos.length === 0) {
                    container.innerHTML = `<p style="width:100%;text-align:center;color:var(--gray);">لا توجد فيديوهات حالياً.</p>`;
                    return;
                }

                videos.forEach(video => {
                    container.innerHTML += `
                        <div class="video-card">
                            <iframe src="${video.url || ''}" title="${video.title || 'Video'}" allowfullscreen></iframe>
                            <h3>${video.title || 'بدون عنوان'}</h3>
                            <p>${video.description || 'لا يوجد وصف'}</p>
                        </div>
                    `;
                });
            })
            .catch(err => {
                console.error("Error loading videos:", err);
                container.innerHTML = `<p style="width:100%;text-align:center;color:var(--gray);">حدث خطأ أثناء تحميل الفيديوهات.</p>`;
            });
    }
</script>