@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "رصد درجات الامتحان الورقي";
}

<link rel="stylesheet" href="~/css/styleadmin.css">

<style>
    .exam-entry-container {
        padding: 20px 0;
    }

    .form-card {
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.05));
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: bold;
            font-size: 14px;
            color: var(--text-color, #1e293b);
        }

    .form-control-custom {
        padding: 10px 12px;
        border: 1px solid var(--border-color, #cbd5e1);
        border-radius: 8px;
        outline: none;
        font-size: 14px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: var(--primary-color, #c5a059);
            box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.2);
        }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .badge-present {
        background-color: #dcfce7;
        color: #15803d;
    }

    .badge-absent {
        background-color: #fee2e2;
        color: #b91c1c;
    }

    .score-input {
        width: 120px;
        text-align: center;
        font-weight: bold;
        margin: 0 auto;
    }

        .score-input:disabled {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
            border-color: #e2e8f0;
        }

    .btn-submit-all {
        background-color: var(--primary-color, #c5a059);
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.1s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-submit-all:hover {
            background-color: #b08d48;
        }

        .btn-submit-all:active {
            transform: scale(0.98);
        }

    .section-header-block h2 {
        font-size: 20px;
        font-weight: bold;
        color: var(--primary-color, #c5a059);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>

<div class="exam-entry-container rtl" dir="rtl">
    <div class="section-header-block">
        <h2><i class="fas fa-file-signature"></i> رصد درجات الامتحان الورقي</h2>
    </div>

    <!-- 1. بيانات الامتحان الأساسية والمجموعة -->
    <div class="form-card">
        <h3 style="margin-bottom: 18px; font-size: 16px; color: var(--primary-color, #c5a059); font-weight: bold;">
            <i class="fas fa-sliders-h"></i> إعدادات الامتحان والحضور
        </h3>

        <div class="form-grid">
            <div class="form-group">
                <label>المجموعة <span style="color:red">*</span></label>
                <select id="slotSelect" class="form-select">
                    <option value="">-- اختر المجموعة --</option>
                    @if (ViewBag.Slots != null)
                    {
                        foreach (var slot in ViewBag.Slots)
                        {
                            <option value="@slot.Id">@slot.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label>تاريخ الحصة / الامتحان <span style="color:red">*</span></label>
                <input type="date" id="examDate" class="form-control-custom" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="onFilterChange()" />
            </div>

            <div class="form-group">
                <label>عنوان الامتحان <span style="color:red">*</span></label>
                <input type="text" id="examTitle" class="form-control-custom" placeholder="مثال: اختبار الشهر الورقي" />
            </div>

            <div class="form-group">
                <label>الدرجة الكلية (Total Marks) <span style="color:red">*</span></label>
                <input type="number" id="totalMarks" class="form-control-custom" value="100" min="1" />
            </div>

            <div class="form-group full-width">
                <label>وصف الامتحان / ملاحظات (اختياري)</label>
                <textarea id="examDescription" class="form-control-custom" rows="2" placeholder="أضف أي ملاحظات أو تفاصيل عن محتوى الامتحان..."></textarea>
            </div>
        </div>
    </div>

    <!-- 2. جدول رصد الدرجات حسب سجل الحضور -->
    <div class="form-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h3 style="font-size: 16px; font-weight: bold;">
                <i class="fas fa-users-class"></i> قائمة الطلاب ورصد الدرجات
            </h3>
            <span id="studentsCountLabel" style="font-size: 13px; background: #e2e8f0; color: #475569; padding: 4px 12px; border-radius: 12px; font-weight: bold;">
                اختر المجموعة والتاريخ لعرض الطلاب
            </span>
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table" style="width: 100%; border-collapse: collapse; text-align: center;">
                <thead>
                    <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <th style="padding: 12px; width: 60px;">#</th>
                        <th style="padding: 12px; text-align: right;">اسم الطالب</th>
                        <th style="padding: 12px; width: 160px;">حالة الحضور</th>
                        <th style="padding: 12px; width: 200px;">الدرجة المستحقة</th>
                    </tr>
                </thead>
                <tbody id="studentsTableBody">
                    <!-- سيتم ملؤه بواسطة الـ JS -->
                </tbody>
            </table>
        </div>

        <div style="margin-top: 25px; text-align: left;">
            <!-- إضافة id="saveBtn" هنا -->
            <button type="button" id="saveBtn" class="btn-submit-all" onclick="savePaperExam()">
                <i class="fas fa-save"></i> حفظ نتائج الامتحان
            </button>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        // 1. ربط تغيير الأحداث لجلب كشف الحضور تلقائياً
        $('#slotSelect, #examDate, #examTitle').on('change input', function() {
            onFilterChange();
        });

        // تشغيل الجلب فوراً عند تحميل الصفحة إذا كانت القوائم محددة مسبقاً
        if ($('#slotSelect').val() && $('#examDate').val()) {
            onFilterChange();
        }
    });

    // =========================================================
    // 1. دالة جلب قائمة الطلاب والدرجات المترصودة
    // =========================================================
    function onFilterChange() {
        const slotId = $('#slotSelect').val();
        const date = $('#examDate').val();
        const title = $('#examTitle').val() ? $('#examTitle').val().trim() : '';
        const tbody = $('#studentsTableBody');

        // لا تشترط وجود العنوان لجلب الحضور، التاريخ والمجموعة كافيان
        if (!slotId || !date) {
            $('#studentsCountLabel').text('اختر المجموعة والتاريخ لعرض الطلاب');
            tbody.html(`
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            رجاءً اختر الموعد والتاريخ لعرض الطلاب
                        </td>
                    </tr>
                `);
            return;
        }

        // عرض مؤشر التحميل (Loading Spinner)
        tbody.html(`
                <tr>
                    <td colspan="4" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted mb-0">جاري تحميل قائمة الطلاب وحالة الحضور...</p>
                    </td>
                </tr>
            `);

        // طلب AJAX للباك إند
        $.ajax({
            url: '@Url.Action("GetAttendanceStudents", "Exams")',
            type: 'GET',
            data: { slotId: slotId, date: date, title: title },
            success: function(response) {
                if (response.success) {
                    renderStudentsTable(response.data, response.totalMarks);
                } else {
                    $('#studentsCountLabel').text('لا توجد بيانات');
                    tbody.html(`
                            <tr>
                                <td colspan="4" class="text-center text-danger py-4">
                                    <i class="fas fa-exclamation-triangle fs-4 d-block mb-2"></i>
                                    ${response.message}
                                </td>
                            </tr>
                        `);
                }
            },
            error: function() {
                $('#studentsCountLabel').text('خطأ في الاتصال');
                tbody.html(`
                        <tr>
                            <td colspan="4" class="text-center text-danger py-4">
                                حدث خطأ أثناء الاتصال بالسيرفر!
                            </td>
                        </tr>
                    `);
            }
        });
    }

    // =========================================================
    // 2. دالة رسم جدول الطلاب داخل الصفحة
    // =========================================================
    function renderStudentsTable(students, totalMarks) {
        const tbody = $('#studentsTableBody');
        tbody.empty();

        if (!students || students.length === 0) {
            $('#studentsCountLabel').text('عدد الطلاب: 0');
            tbody.html(`
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        لا يوجد طلاب مسجلين بحضور في هذا الموعد.
                    </td>
                </tr>
            `);
            return;
        }

        // 💡 طباعة البيانات في الكونسول للتأكد من قيم isPresent القادمة من الباك إند
        console.log("Students Data Received:", students);

        $('#studentsCountLabel').text(`كشف الطلاب (${students.length})`);
        if (totalMarks) {
            $('#totalMarks').val(totalMarks);
        }

        students.forEach((student, index) => {
            // فحص مرن يغطي كافة الأحتمالات (Boolean حقيقي، أو String "true"، أو IsPresent كـ PascalCase)
            const isPresent = (
                student.isPresent === true ||
                student.IsPresent === true ||
                String(student.isPresent).toLowerCase() === 'true' ||
                String(student.IsPresent).toLowerCase() === 'true'
            );

            let statusBadge = isPresent
                ? '<span class="badge" style="background-color: #dcfce7; color: #15803d; padding: 6px 12px; border-radius: 6px; font-weight: bold;">حاضر</span>'
                : '<span class="badge" style="background-color: #fee2e2; color: #b91c1c; padding: 6px 12px; border-radius: 6px; font-weight: bold;">غائب</span>';

            const savedScore = (student.score !== null && student.score !== undefined) ? student.score : '';
            const disabledAttr = isPresent ? '' : 'disabled';
            const scoreValue = isPresent ? savedScore : '0';
            const placeholderText = isPresent ? 'الدرجة' : 'غائب';

            const row = `
                <tr data-student-id="${student.studentId}" style="border-bottom: 1px solid #e2e8f0;">
                    <td class="text-center fw-bold" style="padding: 12px;">${index + 1}</td>
                    <td class="fw-semibold" style="padding: 12px; text-align: right;">${student.studentName}</td>
                    <td class="text-center" style="padding: 12px;">${statusBadge}</td>
                    <td style="padding: 12px;">
                        <input type="number"
                               class="form-control-custom text-center student-score-input"
                               style="max-width: 120px; margin: 0 auto;"
                               data-student-id="${student.studentId}"
                               value="${scoreValue}"
                               placeholder="${placeholderText}"
                               min="0"
                               max="${$('#totalMarks').val() || 100}"
                               ${disabledAttr} />
                    </td>
                </tr>
            `;
            tbody.append(row);
        });
    }
    // =========================================================
    // 3. دالة إرسال وحفظ الدرجات إلى الباك إند
    // =========================================================
    function savePaperExam() {
        const slotId = $('#slotSelect').val();
        const examDate = $('#examDate').val();
        const title = $('#examTitle').val().trim();
        const totalMarks = parseInt($('#totalMarks').val()) || 100;
        const description = $('#examDescription').val();

        if (!slotId || !examDate || !title) {
            alert('يرجى اختيار الموعد، التاريخ، وتحديد عنوان الامتحان قبل الحفظ!');
            return;
        }

        const scoresList = [];
        let isValid = true;

        $('.student-score-input').each(function() {
            const input = $(this);
            const studentId = input.data('student-id');
            const scoreVal = input.val().trim();
            const isDisabled = input.is(':disabled');

            if (!isDisabled) {
                if (scoreVal !== "") {
                    const parsedScore = parseFloat(scoreVal);
                    if (parsedScore < 0 || parsedScore > totalMarks) {
                        alert(`درجة الطالب لا يمكن أن تكون بالسالب أو أكبر من الدرجة الكلية (${totalMarks})!`);
                        input.addClass('is-invalid').focus();
                        isValid = false;
                        return false;
                    }
                    input.removeClass('is-invalid');
                    scoresList.push({ studentId: parseInt(studentId), score: parsedScore });
                } else {
                    scoresList.push({ studentId: parseInt(studentId), score: null });
                }
            } else {
                scoresList.push({ studentId: parseInt(studentId), score: 0 });
            }
        });

        if (!isValid) return;

        const payload = {
            slotId: parseInt(slotId),
            classId: 1, // استبدله بالصف إن وجد
            examDate: examDate,
            title: title,
            totalMarks: totalMarks,
            description: description,
            scores: scoresList
        };

        const saveBtn = $('#saveBtn');
        saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i> جاري الحفظ...');

        $.ajax({
            url: '@Url.Action("SavePaperExamScores", "Exams")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(response) {
                if (response.success) {
                    alert(response.message || 'تم حفظ درجات الامتحان بنجاح!');
                    onFilterChange();
                } else {
                    alert('خطأ: ' + response.message);
                }
            },
            error: function(xhr) {
                alert('حدث خطأ غير متوقع أثناء الحفظ!');
            },
            complete: function() {
                saveBtn.prop('disabled', false).html('<i class="fas fa-save me-1"></i> حفظ نتائج الامتحان');
            }
        });
    }
</script>
