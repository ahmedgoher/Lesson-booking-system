@model Al_Muzayyen.Viewmodel.ExamReviewViewModel

@{
    ViewData["Title"] = "عرض إجابات الامتحان - " + Model.ExamTitle;
    int number = 1;
        if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; // 👈 ضع هنا مسار الـ Layout الخاص بالأدمن عندك
    }
    else
    {
        Layout = "~/Views/Shared/_StudentLayout.cshtml"; // 👈 مسار الـ Layout الخاص بالطالب
    }

}

<style>
    /* بنر التأكيد والنجاح */
    .alert-success-banner {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        padding: 12px 20px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* التنسيقات الخاصة بالإجابات */
    .answer-item.is-correct {
        background-color: #d4edda !important;
        border-color: #28a745 !important;
        color: #155724 !important;
        font-weight: bold;
    }

    .answer-item.is-wrong {
        background-color: #f8d7da !important;
        border-color: #dc3545 !important;
        color: #721c24 !important;
    }

    /* مربع عرض الإجابة النموذجية بالأسفل */
    .correct-answer-box {
        background: #eef9f1;
        border: 1px solid #28a745;
        color: #155724;
        padding: 8px 18px;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
        :root {
        --success: #10b981;
        --error: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --border-radius: 12px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* 1. الشريط العلوي الذكي */
    .top-exam-bar {
        display: flex;
        align-items: center;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        padding: 12px 18px;
        margin-bottom: 24px;
        gap: 16px;
    }

    .timer-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg-dark);
        color: var(--primary-color);
        padding: 10px 20px;
        border-radius: var(--border-radius);
        font-size: 18px;
        font-weight: 800;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
        flex-shrink: 0;
        border: 1px solid var(--primary-color);
    }

        .timer-badge i {
            font-size: 20px;
            color: var(--primary-color);
        }

    .questions-scroll-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        overflow-x: auto;
        flex-grow: 1;
        padding: 6px;
        background: var(--bg-alt-2);
        border-radius: var(--border-radius);
        border: 1px solid var(--border-color);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
        scroll-behavior: smooth;
    }

        .questions-scroll-wrapper::-webkit-scrollbar {
            height: 6px;
        }

        .questions-scroll-wrapper::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 10px;
        }

    .q-btn {
        min-width: 42px;
        height: 42px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        color: var(--text-color);
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        transition: var(--transition);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-sm);
    }

        .q-btn:hover {
            border-color: var(--primary-color);
            transform: translateY(-2px);
        }

        .q-btn.current-active {
            background-color: var(--primary-color) !important;
            color: var(--text-on-primary) !important;
            border-color: var(--primary-color) !important;
            box-shadow: var(--shadow-glow), 0 4px 10px var(--primary-glow);
            transform: scale(1.05);
        }

        .q-btn.state-answered {
            background-color: var(--success) !important;
            border-color: var(--success) !important;
            color: var(--text-on-primary) !important;
        }

        .q-btn.state-skipped {
            background-color: var(--error) !important;
            border-color: var(--error) !important;
            color: var(--text-on-primary) !important;
        }

    /* 2. كارت عرض السؤال والمحتوى */
    .question-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        padding: 28px;
        display: none;
    }

        .question-card.active {
            display: block;
            animation: fadeIn 0.3s ease-in-out;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .question-flex-body {
        display: flex;
        gap: 28px;
        align-items: flex-start;
    }

    .question-image-box {
        position: relative;
        flex-basis: 320px;
        max-width: 320px;
        flex-shrink: 0;
        border-radius: var(--border-radius);
        overflow: hidden;
        border: 2px solid var(--border-color);
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        transition: var(--transition);
        background-color: var(--bg-alt-2);
    }

        .question-image-box:hover {
            border-color: var(--primary-color);
            box-shadow: var(--shadow-glow);
            transform: scale(1.02);
        }

        .question-image-box img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }

    .zoom-overlay {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(15, 23, 42, 0.75);
        color: #fff;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
        backdrop-filter: blur(4px);
    }

    .question-content-box {
        flex: 1;
        width: 100%;
    }

    .question-title {
        font-size: 20px;
        font-weight: 800;
        color: var(--secondary-color);
        margin-bottom: 20px;
        line-height: 1.6;
        border-bottom: 2px solid var(--bg-alt-2);
        padding-bottom: 12px;
    }

        .question-title span {
            color: var(--primary-color);
        }

    .answers-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .answer-item {
        display: flex;
        align-items: center;
        padding: 16px 20px;
        border: 2px solid var(--border-color);
        border-radius: var(--border-radius);
        background: var(--bg-alt);
        cursor: pointer;
        transition: var(--transition);
        font-size: 16px;
        font-weight: 600;
        color: var(--text-color);
    }

        .answer-item:hover {
            border-color: var(--primary-color);
            background: var(--bg-alt-2);
        }

        .answer-item input[type="radio"] {
            margin-left: 14px;
            width: 20px;
            height: 20px;
            accent-color: var(--primary-color);
        }

        .answer-item.selected {
            border-color: var(--primary-color);
            background: var(--primary-glow);
            color: var(--secondary-color);
        }

    /* 3. شريط أزرار التحكم السفلية */
    .actions-footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-top: 24px;
        background: var(--card-bg);
        padding: 16px 24px;
        border-radius: var(--border-radius);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-sm);
        gap: 12px;
    }

    #btnPrev {
        justify-self: start;
    }

    #btnSkip {
        justify-self: center;
        grid-column: 2;
    }

    #btnNext, #btnSubmit {
        justify-self: end;
        grid-column: 3;
    }

    .btn {
        padding: 12px 26px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-prev {
        background-color: var(--bg-alt-2);
        color: var(--secondary-color);
    }

        .btn-prev:hover {
            background-color: var(--border-color);
        }

    .btn-skip {
        background-color: rgba(239, 68, 68, 0.1);
        color: var(--error);
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

        .btn-skip:hover {
            background-color: var(--error);
            color: #ffffff;
        }

    .btn-next {
        background-color: var(--primary-color);
        color: var(--text-on-primary);
    }

        .btn-next:hover {
            background-color: var(--primary-hover);
        }

    .btn-submit {
        background-color: var(--success);
        color: var(--text-on-primary);
    }

        .btn-submit:hover {
            opacity: 0.9;
        }

    .image-modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(6px);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

        .image-modal-overlay.active {
            display: flex;
            animation: fadeIn 0.2s ease-in-out;
        }

    .image-modal-card {
        position: relative;
        max-width: 90%;
        max-height: 90%;
    }

        .image-modal-card img {
            max-width: 100%;
            max-height: 85vh;
            border-radius: var(--border-radius);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 2px solid var(--primary-color);
        }

    .close-modal-btn {
        position: absolute;
        top: -15px;
        right: -15px;
        background: var(--error);
        color: white;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 18px;
        cursor: pointer;
        box-shadow: var(--shadow-md);
    }

    @@media (max-width: 768px) {
        .top-exam-bar {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .timer-badge {
            justify-content: center;
            width: 100%;
        }

        .question-flex-body {
            flex-direction: column;
        }

        .question-image-box {
            flex-basis: 100%;
            max-width: 100%;
            width: 100%;
        }

        .actions-footer {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="exam-container">

    <!-- 🟢 بنر تنبيه أعلى الصفحة بتم التسليم -->
    <div class="alert-success-banner">
        <i class="fas fa-check-circle fa-lg"></i>
        <span>تم تسليم الامتحان بنجاح. يمكنك الآن الاطلاع على تقرير الإجابات والإجابة النموذجية.</span>
    </div>

    <!-- 1. الشريط العلوي -->
    <div class="top-exam-bar">
        <div class="timer-badge" style="background-color: #17a2b8;">
            <i class="fas fa-eye"></i>
            <span>مراجعة الإجابات</span>
        </div>

        <div class="questions-scroll-wrapper" id="questionsNav">
            <!-- سيتم إنشاؤه بالـ JavaScript -->
        </div>
    </div>

    <!-- 2. حاوية الأسئلة -->
    <div id="questionsContainer">

        @foreach (var question in Model.Questions)
        {
            <div class="question-card @(number == 1 ? "active" : "")"
                 data-q-index="@number"
                 data-question-id="@question.QuestionId">

                <div class="question-flex-body">

                    @if (!string.IsNullOrEmpty(question.ImageUrl))
                    {
                        <div class="question-image-box" onclick="zoomImage(this)">
                            <img src="@question.ImageUrl" alt="صورة السؤال" />
                        </div>
                    }

                    <div class="question-content-box">

                        <div class="question-title">
                            <span>@number :</span>
                            @question.QuestionText
                        </div>

                        <div class="answers-list">

                            @foreach (var option in question.Options)
                            {
                                bool isSelectedByStudent = (question.SelectedOptionId == option.OptionId);
                                bool isCorrectOption = option.IsCorrect;

                                string statusClass = "";
                                if (isSelectedByStudent && isCorrectOption)
                                {
                                    statusClass = "is-correct"; // إجابة الطالب وصحيحة
                                }
                                else if (isSelectedByStudent && !isCorrectOption)
                                {
                                    statusClass = "is-wrong"; // إجابة الطالب وخاطئة
                                }
                                else if (isCorrectOption)
                                {
                                    statusClass = "is-correct"; // الإجابة الصحيحة التي لم يختارها الطالب
                                }

                                <label class="answer-item @statusClass">

                                    <input type="radio"
                                           name="Answers[@question.QuestionId]"
                                           value="@option.OptionId"
                                    @(isSelectedByStudent ? "checked" : "")
                                           disabled />

                                    @option.OptionText

                                    @if (isSelectedByStudent && isCorrectOption)
                                    {
                                        <i class="fas fa-check-circle text-success ms-2" title="إجابتك الصحيحة"></i>
                                    }
                                    else if (isSelectedByStudent && !isCorrectOption)
                                    {
                                        <i class="fas fa-times-circle text-danger ms-2" title="إجابتك الخاطئة"></i>
                                    }
                                    else if (isCorrectOption)
                                    {
                                        <i class="fas fa-check text-success ms-2" title="الإجابة الصحيحة"></i>
                                    }

                                </label>
                            }

                        </div>

                    </div>

                </div>

                <!-- تخزين نص الإجابة الصحيحة كـ value مخفي للسؤال الحالي -->
                @{
                    var correctOption = question.Options.FirstOrDefault(o => o.IsCorrect);
                }
                <input type="hidden" class="correct-option-text" value="@(correctOption != null ? correctOption.OptionText : "غير محدد")" />

            </div>

            number++;
        }

    </div>

    <!-- 3. أزرار التنقل السفلية -->
    <div class="actions-footer">
        <button type="button" class="btn btn-prev" id="btnPrev" onclick="prevQuestion()">
            <i class="fas fa-arrow-right"></i> السابق
        </button>

        <!-- بدلاً من زر تخطي: يظهر صندوق الإجابة الصحيحة هنا -->
        <div class="correct-answer-box" id="correctAnswerBox">
            <i class="fas fa-lightbulb text-warning"></i>
            <span>الإجابة الصحيحة: <span id="correctAnswerText">---</span></span>
        </div>

        <button type="button" class="btn btn-next" id="btnNext" onclick="nextQuestion()">
            التالي <i class="fas fa-arrow-left"></i>
        </button>
    </div>

</div>

<!-- 4. النافذة المنبثقة لتكبير الصورة -->
<div class="image-modal-overlay" id="imageModal" onclick="closeImageModal()">
    <div class="image-modal-card" onclick="event.stopPropagation()">
        <button type="button" class="close-modal-btn" onclick="closeImageModal()">&times;</button>
        <img id="modalImg" src="" alt="صورة مكبرة">
    </div>
</div>

<script>
    let currentQuestionIndex = 1;
    let totalQuestions = 0;

    function initReviewEngine() {
        const questionCards = document.querySelectorAll('.question-card');
        totalQuestions = questionCards.length;

        questionCards.forEach((card, index) => {
            const qIndex = index + 1;
            card.setAttribute('data-q-index', qIndex);
        });

        buildNavigationButtons();
        updateUI();
    }

    function buildNavigationButtons() {
        const navContainer = document.getElementById('questionsNav');
        navContainer.innerHTML = '';

        for (let i = 1; i <= totalQuestions; i++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.id = `q-btn-${i}`;
            btn.className = `q-btn ${i === currentQuestionIndex ? 'current-active' : ''}`;
            btn.innerText = i;
            btn.onclick = () => goToQuestion(i);
            navContainer.appendChild(btn);
        }
    }

    function goToQuestion(qIndex) {
        if (qIndex < 1 || qIndex > totalQuestions) return;

        const currentCard = document.querySelector('.question-card.active');
        if (currentCard) currentCard.classList.remove('active');

        currentQuestionIndex = qIndex;
        const targetCard = document.querySelector(`.question-card[data-q-index="${qIndex}"]`);
        if (targetCard) targetCard.classList.add('active');

        updateUI();
    }

    function nextQuestion() {
        if (currentQuestionIndex < totalQuestions) {
            goToQuestion(currentQuestionIndex + 1);
        }
    }

    function prevQuestion() {
        if (currentQuestionIndex > 1) {
            goToQuestion(currentQuestionIndex - 1);
        }
    }

    function updateUI() {
        // 1. تحديث أزرار التنقل بالترقيم
        for (let i = 1; i <= totalQuestions; i++) {
            const btn = document.getElementById(`q-btn-${i}`);
            if (!btn) continue;

            btn.className = 'q-btn';
            if (i === currentQuestionIndex) {
                btn.classList.add('current-active');
            }
        }

        // 2. تحديث أزرار التالي والسابق
        document.getElementById('btnPrev').style.display = (currentQuestionIndex === 1) ? 'none' : 'inline-flex';
        document.getElementById('btnNext').style.display = (currentQuestionIndex === totalQuestions) ? 'none' : 'inline-flex';

        // 3. قراءة الإجابة الصحيحة للـ Card الحالي وعرضها في المنتصف
        const activeCard = document.querySelector(`.question-card[data-q-index="${currentQuestionIndex}"]`);
        if (activeCard) {
            const correctTextInput = activeCard.querySelector('.correct-option-text');
            if (correctTextInput) {
                document.getElementById('correctAnswerText').innerText = correctTextInput.value;
            }
        }
    }

    function zoomImage(element) {
        const imgSrc = typeof element === 'string' ? element : element.querySelector('img')?.src;
        if (imgSrc) {
            document.getElementById('modalImg').src = imgSrc;
            document.getElementById('imageModal').classList.add('active');
        }
    }

    function closeImageModal() {
        document.getElementById('imageModal').classList.remove('active');
    }

    window.onload = () => {
        initReviewEngine();
    };
</script>