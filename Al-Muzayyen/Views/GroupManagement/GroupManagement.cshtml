@using Al_Muzayyen.Viewmodel
@model GroupManagementViewModel

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "إدارة المجموعة";
}

<link rel="stylesheet" href="~/css/styleadmin.css">

<style>
    .group-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card-box {
        background: var(--card-bg, #fff);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--border-color, #e2e8f0);
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.05));
    }

        .stat-card-box i {
            font-size: 28px;
            color: var(--primary-color, #c5a059);
            background: var(--bg-alt-2, #f1f5f9);
            padding: 15px;
            border-radius: 10px;
        }

    .stat-card-info h3 {
        font-size: 14px;
        color: var(--text-muted, #64748b);
        margin-bottom: 5px;
    }

    .stat-card-info p {
        font-size: 20px;
        font-weight: bold;
        color: var(--text-color, #1e293b);
        margin: 0;
    }

    .header-with-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-main-action {
        background-color: var(--primary-color, #c5a059);
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
    }

        .btn-main-action:hover {
            background-color: var(--primary-hover, #b08d4a);
        }

    /* أزرار الحذف الحمراء */
    .btn-delete-icon {
        background-color: #ef4444;
        color: white;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .btn-delete-icon:hover {
            background-color: #dc2626;
        }

    /* Modal Styling */
    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--overlay-bg, rgba(0, 0, 0, 0.6));
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

        .custom-modal-overlay.active {
            display: flex;
        }

    .custom-modal-content {
        background: var(--card-bg, #fff);
        border-radius: 12px;
        width: 90%;
        max-width: 650px;
        padding: 20px;
        max-height: 85vh;
        overflow-y: auto;
    }

    .modal-header-block {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
    }

    .close-modal-btn {
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        color: var(--text-muted, #64748b);
    }

    .filter-inputs-container {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }

    .form-control-custom {
        width: 100%;
        padding: 10px;
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 8px;
        outline: none;
    }

    .videos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .video-card {
        background: var(--card-bg, #fff);
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 12px;
        overflow: hidden;
        padding: 12px;
        box-shadow: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.05));
        position: relative;
    }

        .video-card iframe {
            width: 100%;
            height: 180px;
            border-radius: 8px;
        }

    .video-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }

    .video-card h3 {
        font-size: 16px;
        margin: 0;
    }



    /* أزرار الإجراءات */
.btn-whatsapp-action {
    background-color: #25D366;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    transition: 0.2s;
}

.btn-whatsapp-action:hover {
    background-color: #1eb954;
}

/* تنسيق النوافذ المنبثقة Modal */
.custom-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--overlay-bg, rgba(0, 0, 0, 0.6));
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.custom-modal-overlay.active {
    display: flex;
}

.custom-modal-content {
    background: var(--card-bg, #fff);
    border-radius: 12px;
    width: 90%;
    max-width: 750px;
    padding: 20px;
    max-height: 85vh;
    overflow-y: auto;
}

.modal-header-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
}

.close-modal-btn {
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: var(--text-muted, #64748b);
}

.filter-inputs-container {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
}

.form-control-custom {
    width: 100%;
