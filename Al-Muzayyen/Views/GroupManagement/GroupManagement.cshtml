.Alll{
    color:#c5a059
}
</style>

<div class="group-management-content" style="padding: 20px 0;">

    <!-- 1. الهيدر والإحصائيات -->
    <div class="section-header-block">
        <h2>إدارة المجموعة: @Model.GroupName</h2>
    </div>

    <div class="group-stats-grid">
        <div class="stat-card-box">
            <i class="fas fa-user-graduate"></i>
            <div class="stat-card-info">
                <h3>عدد الطلاب</h3>
                <p>@Model.StudentCount طالب</p>
                <a href="#" onclick="loadGroupStudents()" class="Alll">عرض الكل</a>
            </div>
        </div>

        <div class="stat-card-box">
            <i class="fas fa-video"></i>
            <div class="stat-card-info">
                <h3>عدد الفيديوهات</h3>
                <p>@Model.VideoCount فيديو</p>
            </div>
        </div>

        <div class="stat-card-box">
            <i class="fas fa-file-signature"></i>
            <div class="stat-card-info">
                <h3>عدد الامتحانات</h3>
                <p>@Model.ExamCount امتحان</p>
            </div>
        </div>
    </div>

    <!-- 2. قسم الامتحانات والاختبارات (فرونت إند) -->
    <div class="exams-content" style="margin-bottom: 40px;">
        <div class="section-header-block header-with-btn">
            <h2>امتحانات المجموعة</h2>
            <button class="btn-main-action" onclick="openModal('addExamModal')">
                <i class="fas fa-plus"></i> إضافة امتحان للمجموعة
            </button>
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>اسم الامتحان</th>
                        <th>تاريخ الإضافة</th>
                        <th>عدد الأسئلة</th>
                        <th>نتائج الطلاب</th>
                    </tr>
                </thead>
                <tbody >
                    @foreach (var exam in Model.Exams)
                    {
                        <tr>
                            <td>@exam.Title</td>

                            <td>@exam.CreatedAt.ToString("yyyy-MM-dd")</td>

                            <td>@exam.QuestionsCount سؤال</td>

                            <td>
                                <button class="action-icon-btn"
                                        onclick="showExamResults(@exam.ExamId)"
                                        title="عرض النتائج">

                                    <i class="fas fa-eye"></i>

                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. قسم الملازم والمذكرات المرفوعة -->
    <div class="materials-content" style="margin-bottom: 40px;">
        <div class="section-header-block header-with-btn">
            <h2>الملازم والمذكرات المرفوعة</h2>
            <button class="btn-main-action" onclick="openModal('addMaterialModal')">
                <i class="fas fa-upload"></i> إضافة ملزمة / مذكرة
            </button>
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>عنوان الملزمة</th>
                        <th>تاريخ الإضافة</th>
                        <th style="width: 120px; text-align: center;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Materials != null && Model.Materials.Any())
                    {
                        @foreach (var item in Model.Materials)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td style="text-align: center;">
                                    <div style="display: flex; gap: 8px; justify-content: center;">
                                        <!-- زر التحميل -->
                                        <a href="@item.Url" target="_blank" class="action-icon-btn" title="تحميل / فتح">
                                            <i class="fas fa-download"></i>
                                        </a>

                                        <!-- زر الحذف الأحمر -->
                                        <form asp-action="DeleteMaterial" method="post" style="display:inline;" onsubmit="return confirm('هل أنت تأكد من حذف هذه الملزمة؟');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="slotId" value="@Model.SlotId" />
                                            <button type="submit" class="btn-delete-icon" title="حذف">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; color: var(--text-muted);">لا توجد ملازم مرفوعة لهذه المجموعة حالياً.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. قسم الفيديوهات المرفوعة للمجموعة -->
    <div class="videos-content" style="margin-bottom: 40px;">
        <div class="section-header-block header-with-btn">
            <h2>الفيديوهات المرفوعة للمجموعة</h2>
            <button class="btn-main-action" onclick="openModal('addVideoModal')">
                <i class="fas fa-video"></i> إضافة فيديو جديد
            </button>
        </div>

        <div class="videos-grid">
            @if (Model.Videos != null && Model.Videos.Any())
            {
                @foreach (var video in Model.Videos)
                {
                    <div class="video-card">
                        <!-- تم إضافة allowfullscreen مع الرابط الصحيح لتشغيل الفيديو بدون مشاكل -->
                        <iframe src="@video.Url" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        <div class="video-card-header">
                            <h3>@video.Title</h3>
                            <!-- زر حذف الفيديو الأحمر -->
                            <form asp-action="DeleteMaterial" method="post" style="display:inline;" onsubmit="return confirm('هل أنت تأكد من حذف هذا الفيديو؟');">
                                <input type="hidden" name="id" value="@video.Id" />
                                <input type="hidden" name="slotId" value="@Model.SlotId" />
                                <button type="submit" class="btn-delete-icon" title="حذف الفيديو">
                                    <i class="fas fa-times"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <p style="color: var(--text-muted); grid-column: 1 / -1;">لا توجد فيديوهات مرفوعة لهذه المجموعة حالياً.</p>
            }
        </div>
    </div>

</div>

