                    </tr>
                </thead>
                <tbody id="group-students-body">
                    <!-- سيتم تحميل طلاب المجموعة هنا تلقائياً عبر JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function openModal(modalId) {
        document.getElementById(modalId).classList.add('active');
    }

    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('active');
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('custom-modal-overlay')) {
            event.target.classList.remove('active');
        }
    }
                async function showExamResults(examId) {

                    try {

                        const response = await fetch(`/GroupManagement/GetExamResults?examId=${examId}&slotId=@Model.SlotId`);

                        const result = await response.json();

                        if (!result.success) {

                            alert("حدث خطأ");

                            return;
                        }

                        const tbody =
                            document.getElementById("exam-results-body");

                        tbody.innerHTML = "";

                        result.data.forEach(student => {

                            let score =
                                student.score == null ? "--" : student.score;

                            let submitted =
                                student.submittedAt == null
                                    ? "--"
                                    : new Date(student.submittedAt)
                                        .toLocaleDateString("ar-EG");

                            let statusColor = "";

switch (student.status) {
    case "ناجح":
        statusColor = "green";
        break;

    case "راسب":
        statusColor = "red";
        break;

    case "غائب":
        statusColor = "#dc2626";
        break;

    case "لم يبدأ":
        statusColor = "#2563eb";
        break;

    case "لم يمتحن بعد":
        statusColor = "#f59e0b";
        break;

    default:
        statusColor = "#64748b";
        break;
}

                            tbody.innerHTML += `
                                <tr>

                                    <td>${student.studentName}</td>

                                    <td>${score}</td>

                                    <td>
                                        <span style="color:${statusColor};font-weight:bold;">
                                            ${student.status}
                                        </span>
                                    </td>

                                    <td>${submitted}</td>

                                </tr>
                            `;

                        });

                        openModal("examResultsModal");

                    }
                    catch (e) {

