<!-- Popup 2: إضافة امتحان للمجموعة بالفلترة -->
<div class="custom-modal-overlay" id="addExamModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>اختيار امتحان لإضافته للمجموعة</h3>
            <button class="close-modal-btn" onclick="closeModal('addExamModal')">&times;</button>
        </div>

        <div class="filter-inputs-container">
            <input type="text" class="form-control-custom" placeholder="ابحث باسم الامتحان...">
        </div>

        <div class="table-responsive-container">
            <table class="data-display-table">
                <thead>
                    <tr>
                        <th>اسم الامتحان</th>
                        <th>التاريخ </th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model.AvailableExams)
                    {
                        <tr>

                            <td>@exam.Title</td>

                            <td>@exam.StartExamTime.ToString("yyyy/MM/dd HH:mm")</td>

                            <td>
                                @if (exam.AlreadyAdded)
                                {
                                    <button class="btn-main-action"
                                            disabled
                                            style="background:#9ca3af;cursor:not-allowed;">
                                        موجود بالفعل
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="AddExamToGroup" method="post" style="display:inline;">
                                        <input type="hidden" name="slotId" value="@Model.SlotId" />
                                        <input type="hidden" name="examId" value="@exam.ExamId" />

                                        <button type="submit" class="btn-main-action">
                                            <i class="fas fa-plus"></i>
                                            إضافة
                                        </button>
                                    </form>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Popup 3: رفع ملزمة/مذكرة -->
<div class="custom-modal-overlay" id="addMaterialModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>إضافة ملزمة أو مذكرة جديدة</h3>
            <button class="close-modal-btn" onclick="closeModal('addMaterialModal')">&times;</button>
        </div>
        <form asp-action="AddMaterial" method="post" style="display: flex; flex-direction: column; gap: 15px;">
            <input type="hidden" name="slotId" value="@Model.SlotId" />

            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">عنوان الملزمة/المذكرة</label>
                <input type="text" name="title" class="form-control-custom" placeholder="أدخل العنوان..." required>
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">رابط الملزمة (Google Drive / Direct Link)</label>
                <input type="url" name="url" class="form-control-custom" placeholder="https://drive.google.com/..." required>
            </div>

            <button type="submit" class="btn-main-action" style="justify-content: center; margin-top: 10px;">رفع إلى المجموعة</button>
        </form>
    </div>
</div>

<!-- Popup 4: إضافة فيديو جديد -->
<div class="custom-modal-overlay" id="addVideoModal">
    <div class="custom-modal-content">
        <div class="modal-header-block">
            <h3>إضافة فيديو جديد للمجموعة</h3>
            <button class="close-modal-btn" onclick="closeModal('addVideoModal')">&times;</button>
        </div>
        <form asp-action="AddVideo" method="post" style="display: flex; flex-direction: column; gap: 15px;">
            <input type="hidden" name="slotId" value="@Model.SlotId" />

            <div>
                <label style="display: block; margin-bottom: 5px; font-weight: bold;">عنوان الفيديو</label>
                <input type="text" name="title" class="form-control-custom" placeholder="أدخل عنوان الفيديو..." required>
            </div>
