                <label style="display: block; margin-bottom: 5px; font-weight: bold;">رابط الفيديو (YouTube)</label>
                <input type="url" name="url" class="form-control-custom" placeholder="https://www.youtube.com/watch?v=... أو https://youtu.be/..." required>
            </div>

            <button type="submit" class="btn-main-action" style="justify-content: center; margin-top: 10px;">حفظ وإضافة الفيديو</button>
        </form>
    </div>
</div>


