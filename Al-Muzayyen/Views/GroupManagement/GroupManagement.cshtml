 async function loadGroupStudents() {
    try {
        const response = await fetch(`/GroupManagement/GetGroupStudents?slotId=@Model.SlotId`);

        if (!response.ok) {
            throw new Error("فشل في الاتصال بالسيرفر");
        }

        const result = await response.json();
        const tbody = document.getElementById("group-students-body");
        tbody.innerHTML = "";

        if (result.success && result.data && result.data.length > 0) {
            result.data.forEach(student => {
                // جلب رقم ولي الأمر ورقم الطالب (مع مراعاة حالة الأحرف من الكنترولر)
                let parentPhone = student.parentPhone || student.ParentPhone || "غير متوفر";
                let studentPhone = student.studentPhone || "غير متوفر";

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${student.studentName}</strong></td>
                        <td dir="ltr" style="text-align: right;">${studentPhone}</td>
                        <td dir="ltr" style="text-align: right;">${parentPhone}</td>
                        <td style="text-align: center;">
                            <button class="btn-whatsapp-action" onclick="sendWhatsAppReport('${parentPhone}', '${student.studentName}', '${student.studentToken}')">
                                <i class="fab fa-whatsapp"></i> إرسال التقرير
                            </button>
                        </td>
                    </tr>
                `;
            });
        } else {
            // تم تعديل colspan إلى 4 لأننا أضفنا عمود رقم الطالب
            tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: red;">لا يوجد طلاب مسجلين في هذه المجموعة حالياً.</td></tr>`;
        }

        openModal("studentsListModal");

    } catch (e) {
        console.error(e);
        alert("حدث خطأ أثناء جلب بيانات الطلاب من قاعدة البيانات.");
    }
}
