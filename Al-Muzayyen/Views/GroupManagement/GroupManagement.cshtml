// 2. دالة إرسال تقرير الواتساب
// ==========================================
window.sendWhatsAppReport = function (phone, studentName, studentToken) {
    if (!phone || phone.toString().trim() === "") {
        alert("لا يوجد رقم هاتف متاح لولي الأمر!");
        return;
    }

    const monthSelect = document.getElementById("reportMonth");
    const yearSelect = document.getElementById("reportYear");

    const selectedMonth = monthSelect ? monthSelect.value : "7";
    const selectedYear = yearSelect ? yearSelect.value : "2026";

    const reportUrl = `${window.location.origin}/Report/View?token=${encodeURIComponent(studentToken)}&m=${selectedMonth}&y=${selectedYear}`;
    @* const reportUrl = `https://quickshow.runasp.net/`; *@

    // صياغة الرسالة بشكل مرتب جداً ومريح للعين
    const message = `أهلاً بك ولي أمر الطالب/ة المحترم 🌸\n\n` +
                    `نود إعلامكم بصدور التقرير الشهري للدرجات والحضور للبنك أو الطالب *(${studentName})* عن شهر ${selectedMonth}/${selectedYear}.\n\n` +
                    `📌 *اضغط على الرابط التالي للاطلاع على التقرير مباشرة:*\n` +
                    `${reportUrl}\n\n` +
                    `مع تحيات إدارة المركز التعليمي ✨`;

    let cleanPhone = phone.toString().trim().replace(/\s+/g, '');
    if (cleanPhone.startsWith("0")) {
        cleanPhone = "20" + cleanPhone.substring(1);
    }

    const whatsappUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, '_blank');
};
