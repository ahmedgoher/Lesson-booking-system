@using Al_Muzayyen.Viewmodel

@model MonthlyReportViewModel
@{
    Layout = null;
    // مصفوفة لأسماء الأشهر بالعربي
    string[] monthsNames = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    string monthNameText = (Model.Month >= 1 && Model.Month <= 12) ? monthsNames[Model.Month] : Model.Month.ToString();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التقرير الشهري للطالب - @Model.StudentName</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #d4a24c;
            --primary-hover: #bb8b39;
            --secondary-color: #23395d;
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --warning-color: #f59e0b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Tajawal', sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); padding: 20px; direction: rtl; }
        .report-container { max-width: 1000px; margin: 0 auto; }

        .page-actions { display: flex; justify-content: flex-end; margin-bottom: 20px; }
        .btn-print {
            background-color: var(--secondary-color); color: #fff; border: none; padding: 10px 20px;
            border-radius: 8px; cursor: pointer; font-size: 0.95rem; font-weight: 600;
            display: flex; align-items: center; gap: 8px; transition: 0.3s;
        }
        .btn-print:hover { background-color: #1c304c; }

        .report-header-card {
            background: linear-gradient(135deg, var(--secondary-color), #1a2942);
            color: #fff; border-radius: 16px; padding: 25px; margin-bottom: 25px;
            box-shadow: 0 10px 20px rgba(35, 57, 93, 0.15); display: flex;
            justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;
        }
        .student-details h1 { font-size: 1.8rem; margin-bottom: 10px; color: #fff; }
        .student-meta { display: flex; gap: 15px; flex-wrap: wrap; font-size: 0.95rem; color: #cbd5e1; }
        .student-meta span { display: flex; align-items: center; gap: 6px; }
        .student-meta i { color: var(--primary-color); }

        .month-badge {
            background-color: rgba(212, 162, 76, 0.2); border: 1px solid var(--primary-color);
            color: var(--primary-color); padding: 10px 20px; border-radius: 12px; text-align: center;
        }
        .month-badge span { display: block; font-size: 0.85rem; color: #e2e8f0; }
        .month-badge strong { font-size: 1.2rem; }

        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px; }
        .stat-card {
            background: var(--card-bg); border-radius: 12px; padding: 20px;
            border: 1px solid var(--border-color); box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            display: flex; align-items: center; gap: 15px;
        }
        .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; }
        .stat-icon.attendance { background: rgba(16, 185, 129, 0.1); color: var(--success-color); }
        .stat-icon.exams { background: rgba(35, 57, 93, 0.1); color: var(--secondary-color); }
        .stat-icon.homework { background: rgba(245, 158, 11, 0.1); color: var(--warning-color); }
        .stat-icon.behavior { background: rgba(212, 162, 76, 0.1); color: var(--primary-color); }

        .stat-info h3 { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 4px; }
        .stat-info .value { font-size: 1.4rem; font-weight: 700; color: var(--text-color); }

        .report-section { background: var(--card-bg); border-radius: 12px; padding: 25px; margin-bottom: 25px; border: 1px solid var(--border-color); }
        .section-title { font-size: 1.2rem; color: var(--secondary-color); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; border-bottom: 2px solid var(--bg-color); padding-bottom: 10px; }
        .section-title i { color: var(--primary-color); }

        .table-responsive { width: 100%; overflow-x: auto; }
        .report-table { width: 100%; border-collapse: collapse; text-align: right; min-width: 600px; }
        .report-table th { background-color: #fafbfe; color: var(--text-muted); padding: 12px 15px; font-weight: 600; font-size: 0.9rem; border-bottom: 2px solid var(--border-color); white-space: nowrap; }
        .report-table td { padding: 14px 15px; border-bottom: 1px solid var(--border-color); font-size: 0.95rem; white-space: nowrap; }

        .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block; }
        .status-badge.present { background: rgba(16, 185, 129, 0.1); color: var(--success-color); }
        .status-badge.absent { background: rgba(239, 68, 68, 0.1); color: var(--danger-color); }
        .status-badge.late { background: rgba(245, 158, 11, 0.1); color: var(--warning-color); }
        .grade-badge { font-weight: 700; padding: 4px 12px; border-radius: 8px; background: #f1f5f9; }

        .teacher-notes-box { background-color: #fafbfe; border-right: 4px solid var(--primary-color); border-radius: 8px; padding: 15px 20px; color: #334155; line-height: 1.7; font-size: 0.95rem; }

        @@media print {
            body { background: #fff; padding: 0; }
            .page-actions { display: none; }
            .report-container { max-width: 100%; }
        }
    </style>
</head>
<body>

    <div class="report-container">
        <!-- زر الطباعة -->
        <div class="page-actions">
            <button class="btn-print" onclick="window.print()"><i class="fa-solid fa-print"></i> طباعة التقرير</button>
        </div>

        <!-- هيدر الطالب -->
        <div class="report-header-card">
            <div class="student-details">
                <h1>@Model.StudentName</h1>
                <div class="student-meta">
                    <span><i class="fa-solid fa-graduation-cap"></i> @Model.GradeLevel</span>
                    <span><i class="fa-solid fa-users"></i> مجموعة: @Model.GroupName 
                        @foreach(var day in @Model.DaysSchedule)
                        {
                            <span>@day.Day</span>
                        }
                    </span>
                    <span><i class="fa-solid fa-location-dot"></i> @Model.CenterName</span>
                </div>
            </div>
            <div class="month-badge">
                <span>تقرير شهر</span>
                <strong>@monthNameText @Model.Year</strong>
            </div>
        </div>

        <!-- الكروت الإحصائية -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon attendance"><i class="fa-solid fa-user-check"></i></div>
                <div class="stat-info">
                    <h3>نسبة الحضور</h3>
                    <div class="value">@Model.AttendancePercentage%</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon exams"><i class="fa-solid fa-chart-line"></i></div>
                <div class="stat-info">
                    <h3>متوسط الامتحانات</h3>
                    <div class="value">@Model.AverageExams</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon homework"><i class="fa-solid fa-book-open"></i></div>
                <div class="stat-info">
                    <h3>تسليم الواجبات</h3>
                    <div class="value">@Model.HomeworkCompletion</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon behavior"><i class="fa-solid fa-star"></i></div>
                <div class="stat-info">
                    <h3>التقييم العام</h3>
                    <div class="value" style="color: var(--primary-color);">@Model.GeneralEvaluation</div>
                </div>
            </div>
        </div>

        <!-- جدول الامتحانات -->
        <div class="report-section">
            <div class="section-title"><i class="fa-solid fa-pen-to-square"></i> نتائج امتحانات واختبارات الشهر</div>
            <div class="table-responsive">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>اسم الاختبار / الامتحان</th>
                            <th>التاريخ</th>
                            <th>درجة الطالب</th>
                            <th>الدرجة النهائية</th>
                            <th>التقدير</th>
                            <th>ملاحظات الاختبار</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ExamRecord != null && Model.ExamRecord.Any())
                        {
                            foreach (var exam in Model.ExamRecord)
                            {
                                <tr>
                                    <td><strong>@exam.ExamName</strong></td>
                                    <td>@exam.ExamDate.ToString("yyyy/MM/dd")</td>
                                    <td><span class="grade-badge" style="color: var(--success-color);">@exam.StudentScore</span></td>
                                    <td>@exam.TotalMarks</td>
                                    <td>@exam.GradeText</td>
                                    <td>@exam.Notes</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align: center; color: var(--text-muted);">لا توجد امتحانات مسجلة لهذا الشهر.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- جدول الحضور -->
        <div class="report-section">
            <div class="section-title"><i class="fa-solid fa-calendar-check"></i> سجل الحضور والانضباط الشهري</div>
            <div class="table-responsive">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>تاريخ الحصة</th>
                            @* <th>عنوان الحصة / الدرس</th> *@
                            <th>حالة الحضور</th>
                            <th>حالة الواجب</th>
                            <th>ملاحظات المدرس الحصصية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AttendanceRecord != null && Model.AttendanceRecord.Any())
                        {
                            foreach (var att in Model.AttendanceRecord)
                            {
                                string badgeClass = att.Status == "حاضر" ? "present" : (att.Status == "متأخر" ? "late" : "absent");
                                <tr>
                                    <td>@att.Date.ToString("yyyy/MM/dd")</td>
                                    @* <td>@att.LessonTitle</td> *@
                                    <td><span class="status-badge @badgeClass">@att.Status</span></td>
                                    <td>@att.HomeworkStatus</td>
                                    <td>@att.Notes</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">لا توجد سجلات حضور لهذا الشهر.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ملاحظات المعلم -->
        <div class="report-section">
            <div class="section-title"><i class="fa-solid fa-comment-dots"></i> ملاحظات وتوصيات المعلم لولي الأمر</div>
            <div class="teacher-notes-box">
                @Html.Raw(Model.TeacherNotes)
            </div>
        </div>

    </div>

</body>
</html>